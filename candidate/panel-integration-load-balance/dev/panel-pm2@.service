[Unit]
Description=CloudStack PM2 application %i
After=network.target
[Service]
Type=simple
ExecStart=/opt/panel/bin/panel-executor --serve-pm2 %i
Restart=on-failure
RestartSec=3
# Let the PM2 supervisor stop its workers before systemd kills the cgroup.
# Sending SIGTERM to every worker first can trigger PM2 auto-restart.
KillMode=mixed
TimeoutStopSec=10s
UMask=0027
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/srv/panel/sites
MemoryMax=1G
TasksMax=128
[Install]
WantedBy=multi-user.target
