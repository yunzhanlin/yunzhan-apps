{
  "schema_version": 1,
  "id": "load-balance",
  "name": "负载均衡 · Load Balance",
  "category": "professional",
  "version": "1.3.1",
  "summary": "回环 HTTP 加权分流、IP 粘滞与备用节点；持久事务、旧进程监听交接及入口指纹、修订冲突和安全恢复；节点探测明确为 TCP 建连，不冒充主动应用健康检查。",
  "stage": "ready",
  "risk": "privileged",
  "delivery": {
    "provider": "panel-module",
    "target": "load-balance",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "加权轮询",
    "备用节点",
    "IP 粘滞",
    "TCP 建连探测与入口配置指纹",
    "失败转移",
    "专用操作流程",
    "执行历史",
    "持久两文件事务与中断恢复",
    "手工配置漂移与损坏备份拒绝覆盖",
    "删除重建保留递增修订身份",
    "旧工作进程关闭监听后提交",
    "签名仓库更新请求与任务原子绑定、完成后不重复提交"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/load-balance"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
