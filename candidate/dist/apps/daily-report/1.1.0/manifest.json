{
  "schema_version": 1,
  "id": "daily-report",
  "name": "aaPanel Daily Report",
  "category": "professional",
  "version": "1.1.0",
  "summary": "从实际资源、站点、任务、流量、证书数据生成持久化日报",
  "stage": "ready",
  "risk": "maintained",
  "delivery": {
    "provider": "panel-module",
    "target": "daily-report",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "资源摘要",
    "任务故障摘要",
    "流量与安全摘要",
    "证书到期检查",
    "每日持久化"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/daily-report"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
