{
  "schema_version": 1,
  "id": "network-threat-detection",
  "name": "Network Threat Detection",
  "category": "professional",
  "version": "1.3.3",
  "summary": "独立非 root 被动 IDS 与签名 ET Open 规则。可信停止后同步事件文件与目录，保留原始告警和权限，支持冷启动后读取历史。原生采集需受支持的系统及 Suricata 8.0.8 或同分支更新版。",
  "stage": "ready",
  "risk": "privileged",
  "delivery": {
    "provider": "panel-module",
    "target": "network-threat-detection",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "端口基线与新增监听告警",
    "公网暴露分类",
    "独立非 root 被动 IDS",
    "双签名开源规则数据",
    "显式规则选择与原创回退",
    "新鲜采集计数核对",
    "有界历史与冷启动告警保留",
    "可信停止与日志落盘",
    "修订幂等与中断不重放",
    "停止选择优先于恢复",
    "显式多块缓冲与原生 MTU 核对",
    "Suricata 8.0.8 版本与维护审核"
  ],
  "rule_data_channel": {
    "id": "et-open-web-bsd-v1",
    "format": 1,
    "engine": "suricata-8.0"
  },
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/network-threat-detection"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": false
  },
  "required_panel_features": [
    "network-ids-durable-stop-v1"
  ]
}
