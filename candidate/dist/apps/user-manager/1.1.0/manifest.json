{
  "schema_version": 1,
  "id": "user-manager",
  "name": "aaPanel user Manager",
  "category": "professional",
  "version": "1.1.0",
  "summary": "实际登录、网站范围隔离、越权拒绝、会话撤销和账户删除通过",
  "stage": "ready",
  "risk": "privileged",
  "delivery": {
    "provider": "panel-module",
    "target": "user-manager",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "多用户",
    "三种角色",
    "网站权限范围",
    "会话撤销",
    "保留最后管理员"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/user-manager"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
