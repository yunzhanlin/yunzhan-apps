{
  "schema_version": 1,
  "id": "php-55",
  "name": "PHP 5.5",
  "category": "deployment",
  "version": "5.5",
  "summary": "为古早站点导出与升级提供短时隔离环境，不提供公网直连。",
  "stage": "design",
  "risk": "eol",
  "delivery": {
    "provider": "compose",
    "target": "php-55",
    "image": "ghcr.io/yunzhanlin/php-fpm:5.5",
    "manage_route": "runtimes"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13"
    ],
    "architectures": [
      "amd64"
    ]
  },
  "capabilities": [
    "数据导出",
    "迁移兼容",
    "网络隔离",
    "短时启动"
  ],
  "health": {
    "probe": "tcp",
    "target": "php-fpm:9000"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
