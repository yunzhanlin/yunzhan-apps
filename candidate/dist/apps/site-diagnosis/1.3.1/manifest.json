{
  "schema_version": 1,
  "id": "site-diagnosis",
  "name": "Site Diagnosis",
  "category": "professional",
  "version": "1.3.1",
  "summary": "检查真实网站入口、DNS、证书和文件权限。Apache 网站额外核对受管虚拟主机配置、服务主进程和回环监听。",
  "stage": "ready",
  "risk": "maintained",
  "delivery": {
    "provider": "panel-module",
    "target": "site-diagnosis",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "实际域名绑定与 HTTP 状态",
    "DNS 与 HTTPS 证书检查",
    "Nginx 配置和站点文件权限",
    "Apache 虚拟主机和配置语法",
    "Apache 主进程与监听归属",
    "批量诊断与 HTML 报告"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/site-diagnosis"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": false
  },
  "required_panel_features": [
    "site-diagnosis-apache-v1"
  ]
}
