{
  "schema_version": 1,
  "id": "nfs-manager",
  "name": "NFS Manager",
  "category": "professional",
  "version": "1.3.2",
  "summary": "独立 NFSv4 网站导出、身份映射、双栈持久挂载与事务恢复。网站归档前核对共享引用和异常记录，执行时再次保护；保留原文件、独立运行时及既有系统 RPC。",
  "stage": "ready",
  "risk": "privileged",
  "delivery": {
    "provider": "panel-module",
    "target": "nfs-manager",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "NFSv4",
    "独立服务端与网站导出",
    "只读与确认后的读写共享",
    "客户端 CIDR 与网站身份映射",
    "IPv4/IPv6 自定义端口",
    "安全挂载、外部挂载不接管与目录身份核对",
    "开机恢复",
    "修订保护与失败回滚",
    "独立挂载工具与原 RPC 服务保留",
    "活跃挂载卸载保护",
    "归档前引用检查与排队保护",
    "完整许可与执行历史"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/nfs-manager"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  },
  "required_panel_features": [
    "nfs-site-archive-preflight-v1"
  ]
}
