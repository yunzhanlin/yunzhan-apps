      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "NFSv4",
    "安全挂载选项",
    "开机恢复",
    "活跃挂载卸载保护"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/nfs-manager"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
