{
  "schema_version": 1,
  "id": "php-code-security",
  "name": "PHP code security",
  "category": "professional",
  "version": "1.3.1",
  "summary": "扫描和隔离 PHP 风险文件，保留可核对备份与无覆盖恢复，并支持按网站开启或撤销 PHP-FPM 进程函数限制。",
  "stage": "ready",
  "risk": "maintained",
  "delivery": {
    "provider": "panel-module",
    "target": "php-code-security",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "高风险函数与编码混淆特征",
    "真实静态扫描、证据行号与多条件筛选",
    "SHA-256 精确审查与确认",
    "单文件原子隔离",
    "站点外 root 私有独立备份",
    "无覆盖内容与权限恢复",
    "中断事务显式修复",
    "分页隔离箱与备份验证",
    "签名 Webhook 可选告警",
    "卸载与网站归档引用保护",
    "专用工作台与私有执行历史",
    "站点 PHP-FPM 进程函数限制"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/php-code-security"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  },
  "required_panel_features": [
    "php-fpm-process-policy-v1"
  ]
}
