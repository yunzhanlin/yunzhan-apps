    "网站同步部署",
    "域名绑定",
    "数据卷持久化"
  ],
  "health": {
    "probe": "http",
    "target": "/.__cloudstack_health"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
