{
  "schema_version": 1,
  "id": "anti-intrusion",
  "name": "SSH 防入侵 · Anti-intrusion",
  "category": "professional",
  "version": "1.1.2",
  "summary": "SSH 失败登录的双栈封禁、审计解封和原任务恢复。支持 Debian 12/13 与 Ubuntu 22.04/24.04，更新保留现有策略、封禁和原任务。",
  "stage": "ready",
  "risk": "privileged",
  "delivery": {
    "provider": "panel-module",
    "target": "intrusion-prevention",
    "manage_route": "security"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "实际 SSH 端口与 IPv4/IPv6 封禁核验",
    "固定 systemd 日志和原生 nftables",
    "文件、进程起始身份、运行策略及内核联合核对",
    "保留现有封禁的限额及端口配置",
    "原任务与完整摘要绑定的显式恢复",
    "未知结果保留原证据且禁止隐式重试",
    "审计解封与并发互斥",
    "原账户请求目录和后端权限约束",
    "Ubuntu22.04 / Fail2ban0.11.2 固定兼容",
    "Debian 12 / Fail2ban 1.0.2 兼容",
    "保留旧版本策略与事务回执"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/software"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  },
  "required_panel_features": [
    "intrusion-preserving-journal-v2",
    "intrusion-upstream0112-v1",
    "intrusion-debian12-v1"
  ]
}
