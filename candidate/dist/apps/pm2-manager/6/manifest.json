{
  "schema_version": 1,
  "id": "pm2-manager",
  "name": "PM2 Manager",
  "category": "deployment",
  "version": "6",
  "summary": "管理 Node.js 项目进程、启停、日志、开机恢复与状态检查。",
  "stage": "integration",
  "risk": "maintained",
  "delivery": {
    "provider": "panel-module",
    "target": "pm2-manager",
    "manage_route": "runtimes"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "进程生命周期",
    "日志",
    "开机恢复",
    "站点绑定"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/node/apps"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
