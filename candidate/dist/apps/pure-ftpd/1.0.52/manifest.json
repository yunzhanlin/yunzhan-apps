{
  "schema_version": 1,
  "id": "pure-ftpd",
  "name": "Pure-FTPd",
  "category": "deployment",
  "version": "1.0.52",
  "summary": "提供受限 FTP/FTPS 账号、站点目录隔离、配额与审计，默认不公开端口。",
  "stage": "integration",
  "risk": "privileged",
  "delivery": {
    "provider": "compose",
    "target": "pure-ftpd",
    "image": "ghcr.io/yunzhanlin/pure-ftpd:1.0.52",
    "manage_route": "files"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13"
    ],
    "architectures": [
      "amd64"
    ]
  },
  "capabilities": [
    "FTP/FTPS",
    "虚拟账号",
    "目录隔离",
    "配额"
  ],
  "health": {
    "probe": "tcp",
    "target": "127.0.0.1:21"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
