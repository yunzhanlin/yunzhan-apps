{
  "schema_version": 1,
  "id": "pure-ftpd",
  "name": "Pure-FTPd",
  "category": "deployment",
  "version": "1.0.54-compat7",
  "summary": "独立 Pure-FTPd 1.0.54，网站 chroot 与双通道 FTPS，支持账户限速、软配额、访问和会话限制。可按时间、站点、账户和方向查询当前保留的真实传输日志。",
  "stage": "ready",
  "risk": "privileged",
  "delivery": {
    "provider": "panel-module",
    "target": "pure-ftpd",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "双通道 FTPS 与 chroot",
    "虚拟账户与密码轮换",
    "账户上传下载限速",
    "真实 FTPS 上传下载与传输日志",
    "FTP 容量与数量软配额",
    "客户端 IPv4/CIDR 访问控制",
    "双文件失败恢复",
    "被动端口与 NAT 通告",
    "系统信任的域名证书",
    "账户会话与服务连接限额",
    "真实 TLS、在线事务验证与配置回滚",
    "独立运行时校验与重启恢复"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/pure-ftpd"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  },
  "required_panel_features": [
    "pure-ftpd-transfer-history-v1"
  ]
}
