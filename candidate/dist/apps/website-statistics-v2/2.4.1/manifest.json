{
  "schema_version": 1,
  "id": "website-statistics-v2",
  "name": "Website statistics-v2",
  "category": "professional",
  "version": "2.4.1",
  "summary": "真实日志后台增量 SQLite 历史、30 天/25 万行有界保留、筛选及精确耗时分布。修复长期轮转耗尽文件进度容量：仅退役已读完、已消失且超过保留窗口的进度，不删原日志或未读/冲突证据；与新请求同事务提交。必须先升级到支持该能力的面板；旧处理器拒绝安装。压缩导入及地理信息未提供。",
  "stage": "ready",
  "risk": "maintained",
  "delivery": {
    "provider": "panel-module",
    "target": "website-statistics-v2",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "小时趋势",
    "独立 IP",
    "爬虫识别",
    "错误数",
    "路径排行",
    "来源统计",
    "时间与状态筛选",
    "路径/IP 筛选",
    "慢请求明细",
    "30 天后台增量历史与过期已读进度安全退役",
    "检查点与请求同事务及中断保护",
    "精确 P50/P90/P95/P99、九段耗时分布及空样本/超限告警"
  ],
  "required_panel_features": [
    "statistics-cursor-retirement-v1"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/website-statistics-v2"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": false
  }
}
