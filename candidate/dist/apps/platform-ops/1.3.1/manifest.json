{
  "schema_version": 1,
  "id": "platform-ops",
  "name": "Platform Ops",
  "category": "professional",
  "version": "1.3.1",
  "summary": "多主机健康检查、单机受控 Nginx 维护，以及 2–8 台独立授权面板的批量配置检查。逐台核对计划及原回执，结果未确认时只读核对。",
  "stage": "ready",
  "risk": "privileged",
  "delivery": {
    "provider": "panel-module",
    "target": "platform-ops",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "多主机 HTTPS 健康聚合",
    "旧只读令牌不升级权限",
    "加密凭据与令牌撤销",
    "独立限时可撤销维护授权",
    "安装实例绑定及重装旧授权失效",
    "两端管理员与计划摘要核对",
    "固定 Nginx 配置检查；可按 2–8 台主机批量检查",
    "主机级受控重载提交",
    "原任务原生回执核对",
    "逐台结果与原请求回执；未知状态只读核对",
    "不执行自由脚本或补丁发布",
    "执行历史"
  ],
  "required_panel_features": [
    "platform-maintenance-v1",
    "platform-maintenance-fleet-check-v1"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/platform-ops"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
