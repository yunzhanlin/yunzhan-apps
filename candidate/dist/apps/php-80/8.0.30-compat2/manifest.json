{
  "schema_version": 1,
  "id": "php-80",
  "name": "PHP 8.0",
  "category": "deployment",
  "version": "8.0.30-compat2",
  "summary": "PHP 8.0.30 隔离兼容版，包含经核对的开源回移补丁。通过独立 PHP-FPM、Nginx、回环端口和数据卷运行，适用于 AMD64 与 ARM64 的旧站迁移。",
  "stage": "ready",
  "risk": "eol",
  "delivery": {
    "provider": "compose",
    "target": "php-legacy-80-bullseye-compat2",
    "image": "ghcr.io/yunzhanlin/yunzhan-apps-php80:8.0.30-compat2@sha256:6f1ded5a5e08fc7f31efc5416cc0b877d75f94f576ed0d44bbb8d78319da3eed",
    "manage_route": "docker",
    "isolation": "legacy-container"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "固定镜像摘要",
    "独立 PHP-FPM",
    "独立 Nginx",
    "网站同步部署",
    "域名绑定",
    "数据卷持久化",
    "已验证的开源回移补丁"
  ],
  "health": {
    "probe": "http",
    "target": "/.__cloudstack_health"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
