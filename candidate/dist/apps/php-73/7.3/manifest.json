{
  "schema_version": 1,
  "id": "php-73",
  "name": "PHP 7.3",
  "category": "deployment",
  "version": "7.3",
  "summary": "为旧站迁移提供隔离的 PHP 7.3 FPM，默认不允许新项目选用。",
  "stage": "integration",
  "risk": "eol",
  "delivery": {
    "provider": "compose",
    "target": "php-73",
    "image": "ghcr.io/yunzhanlin/php-fpm:7.3",
    "manage_route": "runtimes"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13"
    ],
    "architectures": [
      "amd64"
    ]
  },
  "capabilities": [
    "FPM",
    "迁移兼容",
    "回环网络",
    "EOL 警告"
  ],
  "health": {
    "probe": "tcp",
    "target": "php-fpm:9000"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
