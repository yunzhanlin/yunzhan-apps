{
  "schema_version": 1,
  "id": "nginx-waf",
  "name": "Nginx 请求防火墙 · Nginx WAF",
  "category": "professional",
  "version": "2.0.0",
  "summary": "独立请求元数据防护工作台：分类规则、站点策略、IPv4/IPv6 名单、URL CC、自定义字面规则、真实防护报表与备份回滚；不含完整请求体检测。",
  "stage": "ready",
  "risk": "maintained",
  "delivery": {
    "provider": "panel-module",
    "target": "nginx-waf",
    "manage_route": "security"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "分类规则与观察模式",
    "站点独立策略",
    "IPv4/IPv6 与 URL/UA 名单",
    "每站点 IP 与 URL CC 限速",
    "自定义字面匹配规则",
    "真实日志筛选、排行与导出",
    "安全配置导入与预览",
    "配置备份、修订冲突检查与重载探针"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/software/nginx-waf/config"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
