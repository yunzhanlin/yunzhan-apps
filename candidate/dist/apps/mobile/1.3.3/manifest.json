{
  "schema_version": 1,
  "id": "mobile",
  "name": "云栈移动端",
  "category": "professional",
  "version": "1.3.3",
  "summary": "原签名 Android APK、iOS 源码与未签名 arm64 构建。前台附件下载、系统保存、Android 回读核对及后台网页与文件名隐藏；Android 需更新系统 WebView，iOS 安装需开发者签名。",
  "stage": "ready",
  "risk": "maintained",
  "delivery": {
    "provider": "panel-module",
    "target": "mobile-pwa",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "响应式 PWA 界面",
    "原签名 Android APK 与本地网络显式授权",
    "iOS 源码与未签名 arm64 设备构建",
    "可信 HTTPS 与精确来源验证",
    "后台锁定、隐藏网页与文件名及设备认证",
    "本地会话清除，不缓存 API 或凭据",
    "SHA-256 交付校验与 Android 保存后回读",
    "现有 TOTP 登录",
    "前台附件下载、系统保存与取消重选",
    "过期连接与文档回调隔离",
    "Android 系统 WebView 兼容提示",
    "iOS 系统文件提供方导出"
  ],
  "required_panel_features": [
    "mobile-native-delivery-v133"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/mobile-pwa"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": false
  }
}
