{
  "schema_version": 1,
  "id": "php-70",
  "name": "PHP 7.0",
  "category": "deployment",
  "version": "7.0.33",
  "summary": "停止官方维护的旧版 PHP：固定摘要 PHP-FPM，独立命名卷与只读文件系统；经文件同步部署并绑定受管域名。仅用于兼容迁移。",
  "stage": "ready",
  "risk": "eol",
  "delivery": {
    "provider": "compose",
    "target": "php-legacy-70",
    "image": "devilbox/php-fpm:7.0-mods@sha256:b2ded3e0a1ee36da20c79ec8f3461026559b85c27126015dd46bf04e4793c961",
    "manage_route": "docker",
    "isolation": "legacy-container"
  },
  "compatibility": {
    "os": [
      "debian-13"
    ],
    "architectures": [
      "amd64"
    ]
  },
  "capabilities": [
    "固定镜像摘要",
    "独立 PHP-FPM",
    "独立 Nginx",
    "网站同步部署",
    "域名绑定",
    "数据卷持久化"
  ],
  "health": {
    "probe": "http",
    "target": "/.__cloudstack_health"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
