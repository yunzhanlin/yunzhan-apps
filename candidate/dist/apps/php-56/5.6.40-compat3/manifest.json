{
  "schema_version": 1,
  "id": "php-56",
  "name": "PHP 5.6",
  "category": "deployment",
  "version": "5.6.40-compat3",
  "summary": "PHP 5.6.40 隔离兼容版，包含经核对的开源回移补丁。通过独立 PHP-FPM、Nginx、回环端口和数据卷运行，适用于 AMD64 与 ARM64 的旧站迁移。",
  "stage": "ready",
  "risk": "eol",
  "delivery": {
    "provider": "compose",
    "target": "php-legacy-56-stretch-compat3",
    "image": "ghcr.io/yunzhanlin/yunzhan-apps-php56:5.6.40-compat3@sha256:7e553b5f2aefc08cf85c3aca8dfc288807788a71e3297c26861ac51a78686756",
    "manage_route": "docker",
    "isolation": "legacy-container"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "固定镜像摘要",
    "独立 PHP-FPM",
    "独立 Nginx",
    "网站同步部署",
    "域名绑定",
    "数据卷持久化",
    "已验证的开源回移补丁"
  ],
  "health": {
    "probe": "http",
    "target": "/.__cloudstack_health"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
