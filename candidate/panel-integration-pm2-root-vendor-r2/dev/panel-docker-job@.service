[Unit]
Description=Panel Docker operation %i
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/panel/bin/panel-executor --docker-job %i
TimeoutStartSec=25min
KillMode=control-group
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/panel-executor
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
