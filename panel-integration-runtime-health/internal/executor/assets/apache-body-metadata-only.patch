+/* Yunzhan modification 2026-10-11. No request bytes, rule messages, URI,
+ * hostname, client address, headers or debug text enter this metadata sink.
+ * Fixed path, fixed schema, 32 MiB physical ceiling and nonblocking lock.
+ * A saturated/unavailable sink never changes the detection decision. */
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+static void panel_body_metadata(modsec_rec *msr, int level, msre_actionset *as)
+{
+    const char *site;
+    unsigned int id = 0;
+    size_t i, id_len;
+    int fd, length;
+    struct stat st;
+    char event[256];
+    ssize_t written;
+    if (level > 3 || msr == NULL || msr->r == NULL || msr->txcfg == NULL
+            || as == NULL || as->id == NULL || msr->phase < 1 || msr->phase > 5
+            || msr->txcfg->is_enabled == MODSEC_DISABLED) return;
+    site = get_env_var(msr->r, "PANEL_AW_SITE");
+    if (site == NULL || strnlen(site, 33) != 32) return;
+    for (i = 0; i < 32; i++) {
+        if (!((site[i] >= '0' && site[i] <= '9')
+                || (site[i] >= 'a' && site[i] <= 'f'))) return;
+    }
+    id_len = strnlen(as->id, 9);
+    if (id_len == 0 || id_len > 8) return;
+    for (i = 0; i < id_len; i++) {
+        if (as->id[i] < '0' || as->id[i] > '9') return;
+        id = id * 10 + (unsigned int)(as->id[i] - '0');
+    }
+    if (id == 0 || id > 99999999) return;
+    length = apr_snprintf(event, sizeof(event),
+        "{\"time_us\":%" APR_TIME_T_FMT ",\"engine\":\"2.9.15-yz5\","
+        "\"site_id\":\"%s\",\"rule_id\":%u,\"phase\":%u,\"severity\":%d,"
+        "\"mode\":\"%s\",\"blocked\":%s}\n",
+        apr_time_now(), site, id, msr->phase,
+        (as->severity >= 0 && as->severity <= 7) ? as->severity : 7,
+        msr->txcfg->is_enabled == MODSEC_DETECTION_ONLY ? "observe" : "block",
+        msr->txcfg->is_enabled == MODSEC_ENABLED && msr->was_intercepted
+                && as == msr->intercept_actionset ? "true" : "false");
+    if (length <= 0 || length >= (int)sizeof(event)) return;
+    fd = open("/var/lib/panel-apache-body/events.log",
+        O_WRONLY | O_APPEND | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC);
+    if (fd < 0) return;
+    if (flock(fd, LOCK_EX | LOCK_NB) == 0) {
+        if (fstat(fd, &st) == 0 && S_ISREG(st.st_mode) && st.st_nlink == 1
+                && st.st_uid == geteuid() && (st.st_mode & 07777) == 0600
+                && st.st_size >= 0 && st.st_size <= 32 * 1024 * 1024 - length) {
+            written = write(fd, event, (size_t)length);
+            if (written >= 0 && written != length) (void)ftruncate(fd, st.st_size);
+        }
+        (void)flock(fd, LOCK_UN);
+    }
+    (void)close(fd);
+}
