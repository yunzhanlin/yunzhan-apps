+
+/* CloudStack: dedicated numerical-event log. This avoids mixing private
+ * Nginx request/body-buffer warnings into the managed WAF event stream. */
+static char *
+ngx_conf_set_metadata_log(ngx_conf_t *cf, ngx_command_t *cmd, void *conf)
+{
+    ngx_http_modsecurity_main_conf_t *main = conf;
+    ngx_str_t *value = cf->args->elts;
+    if (main->metadata_log != NULL) {
+        return "is duplicate";
+    }
+    if (value[1].len == 0 || value[1].len > 512 || value[1].data[0] != '/') {
+        return "requires a bounded absolute metadata log path";
+    }
+    main->metadata_log = ngx_pcalloc(cf->pool, sizeof(ngx_log_t));
+    if (main->metadata_log == NULL) {
+        return NGX_CONF_ERROR;
+    }
+    main->metadata_log->file = ngx_conf_open_file(cf->cycle, &value[1]);
+    if (main->metadata_log->file == NULL) {
+        return NGX_CONF_ERROR;
+    }
+    main->metadata_log->log_level = NGX_LOG_WARN;
+    return NGX_CONF_OK;
+}
 
