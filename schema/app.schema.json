{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yunzhanlin/yunzhan-apps/schema/app.schema.json",
  "title": "YunZhan application package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "category",
    "version",
    "summary",
    "stage",
    "delivery",
    "compatibility",
    "capabilities",
    "health",
    "uninstall"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 80 },
    "category": { "enum": ["deployment", "professional"] },
    "version": { "type": "string", "pattern": "^[0-9][0-9A-Za-z.+_-]*$" },
    "summary": { "type": "string", "minLength": 8, "maxLength": 240 },
    "stage": { "enum": ["ready", "integration", "design"] },
    "risk": { "enum": ["maintained", "maintenance", "eol", "privileged"] },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "target"],
      "properties": {
        "provider": { "enum": ["runtime", "compose", "panel-module"] },
        "target": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
        "image": { "type": "string", "maxLength": 240 },
        "isolation": { "enum": ["legacy-container"] },
        "manage_route": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architectures"],
      "properties": {
        "os": { "type": "array", "minItems": 1, "items": { "enum": ["debian-12", "debian-13", "ubuntu-22.04", "ubuntu-24.04", "ubuntu-26.04"] } },
        "architectures": { "type": "array", "minItems": 1, "items": { "enum": ["amd64", "arm64"] } }
      }
    },
    "capabilities": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 2, "maxLength": 64 } },
    "required_panel_features": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$", "enum": ["statistics-cursor-retirement-v1", "statistics-request-identity-v1", "statistics-geodata-v2", "platform-maintenance-v1", "disk-inode-usage-v1", "disk-host-jobs-v1", "compose-memcached-digest-v1", "analytics-session-lifecycle-v1", "hardening-reversible-journal-v1","intrusion-preserving-journal-v2","waf-bound-health-v1"] } },
    "geo_data_channel": {
      "type": "object", "additionalProperties": false, "required": ["id", "format"],
      "properties": { "id": { "const": "dbip-city-lite-v1" }, "format": { "const": 1 } }
    },
    "rule_data_channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "format", "engine"],
      "properties": {
        "id": { "const": "et-open-web-bsd-v1" },
        "format": { "const": 1 },
        "engine": { "const": "suricata-8.0" }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe"],
      "properties": {
        "probe": { "enum": ["binary", "systemd", "tcp", "http", "panel-api"] },
        "target": { "type": "string", "maxLength": 160 }
      }
    },
    "uninstall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserve_data", "reference_check"],
      "properties": {
        "preserve_data": { "type": "boolean" },
        "reference_check": { "type": "boolean" }
      }
    }
  },
  "allOf": [{
    "if": { "required": ["required_panel_features"] },
    "then": {
      "oneOf": [{"properties": {
        "id": {"const":"website-statistics-v2"},
        "delivery": {"properties":{"provider":{"const":"panel-module"},"target":{"const":"website-statistics-v2"}}},
        "required_panel_features": {"items":{"enum":["statistics-cursor-retirement-v1","statistics-request-identity-v1","statistics-geodata-v2"]}}
      }},{"properties": {
        "id": {"const":"platform-ops"}, "version":{"const":"1.3.0"},
        "delivery": {"properties":{"provider":{"const":"panel-module"},"target":{"const":"platform-ops"}}},
        "required_panel_features": {"minItems":1,"maxItems":1,"items":{"const":"platform-maintenance-v1"}}
      }},{"properties": {
        "id": {"const":"disk-analysis"}, "version":{"const":"1.3.0"},
        "delivery": {"properties":{"provider":{"const":"panel-module"},"target":{"const":"disk-analysis"},"manage_route":{"const":"app-modules"}}},
        "required_panel_features": {"minItems":1,"maxItems":1,"items":{"const":"disk-inode-usage-v1"}}
      }},{"properties": {
        "id": {"const":"disk-analysis"}, "version":{"const":"1.4.0"},
        "delivery": {"properties":{"provider":{"const":"panel-module"},"target":{"const":"disk-analysis"},"manage_route":{"const":"app-modules"}}},
        "required_panel_features": {"minItems":2,"maxItems":2,"items":{"enum":["disk-inode-usage-v1","disk-host-jobs-v1"]},"allOf":[{"contains":{"const":"disk-inode-usage-v1"}},{"contains":{"const":"disk-host-jobs-v1"}}]}
      }},{"properties": {
        "id":{"const":"memcached"},"version":{"const":"1.6.45-compat2"},
        "delivery":{"properties":{"provider":{"const":"compose"},"target":{"const":"memcached-cache"},"manage_route":{"const":"docker"},"image":{"const":"memcached:1.6.45-alpine@sha256:9e4de012dc607573052061c0bcb38abc775e1dd59b24e7ac38d1892842094aaf"}},"required":["provider","target","manage_route","image"],"not":{"required":["isolation"]}},
        "required_panel_features":{"minItems":1,"maxItems":1,"items":{"const":"compose-memcached-digest-v1"}}
      }},{"properties": {
        "id":{"const":"website-analytics"},"version":{"const":"2.3.1"},
        "delivery":{"properties":{"provider":{"const":"panel-module"},"target":{"const":"website-analytics"},"manage_route":{"const":"app-modules"}}},
        "required_panel_features":{"minItems":1,"maxItems":1,"items":{"const":"analytics-session-lifecycle-v1"}}
      }},{"properties": {
        "id":{"const":"system-hardening"},"version":{"const":"1.1.0"},
        "delivery":{"properties":{"provider":{"const":"panel-module"},"target":{"const":"system-hardening"},"manage_route":{"const":"security"}}},
        "required_panel_features":{"minItems":1,"maxItems":1,"items":{"const":"hardening-reversible-journal-v1"}}
      }},{"properties": {
        "id":{"const":"nginx-waf"},"version":{"const":"2.5.2"},
        "delivery":{"properties":{"provider":{"const":"panel-module"},"target":{"const":"nginx-waf"},"manage_route":{"const":"security"}}},
        "required_panel_features":{"minItems":1,"maxItems":1,"items":{"const":"waf-bound-health-v1"}}
      }},{"properties": {
        "id":{"const":"anti-intrusion"},"version":{"const":"1.1.0"},
        "delivery":{"properties":{"provider":{"const":"panel-module"},"target":{"const":"intrusion-prevention"},"manage_route":{"const":"security"}}},
        "required_panel_features":{"minItems":1,"maxItems":1,"items":{"const":"intrusion-preserving-journal-v2"}}
      }}]
    }
  },{
    "if":{"required":["id","version"],"properties":{"id":{"const":"nginx-waf"},"version":{"const":"2.5.2"}}},
    "then":{"required":["required_panel_features"],"properties":{"required_panel_features":{"minItems":1,"maxItems":1,"items":{"const":"waf-bound-health-v1"}}}}
  },{
    "if":{"required":["id","version"],"properties":{"id":{"const":"system-hardening"},"version":{"const":"1.1.0"}}},
    "then":{"required":["required_panel_features"],"properties":{"required_panel_features":{"minItems":1,"maxItems":1,"items":{"const":"hardening-reversible-journal-v1"}}}}
  },{
    "if":{"required":["id","version"],"properties":{"id":{"const":"website-analytics"},"version":{"const":"2.3.1"}}},
    "then":{"required":["required_panel_features"],"properties":{"required_panel_features":{"minItems":1,"maxItems":1,"items":{"const":"analytics-session-lifecycle-v1"}}}}
  },{
    "if":{"required":["id","version"],"properties":{"id":{"const":"memcached"},"version":{"const":"1.6.45-compat2"}}},
    "then":{"required":["required_panel_features"],"properties":{"required_panel_features":{"minItems":1,"maxItems":1,"items":{"const":"compose-memcached-digest-v1"}}}}
  },{
    "if": {"required":["id","version"],"properties":{"id":{"const":"platform-ops"},"version":{"const":"1.3.0"}}},
    "then": {"required":["required_panel_features"],"properties":{"required_panel_features":{"contains":{"const":"platform-maintenance-v1"}}}}
  },{
    "if": {"required":["id","version"],"properties":{"id":{"const":"disk-analysis"},"version":{"const":"1.3.0"}}},
    "then": {"required":["required_panel_features"],"properties":{"required_panel_features":{"minItems":1,"maxItems":1,"items":{"const":"disk-inode-usage-v1"}}}}
  },{
    "if": {"required":["id","version"],"properties":{"id":{"const":"disk-analysis"},"version":{"const":"1.4.0"}}},
    "then": {"required":["required_panel_features"],"properties":{"required_panel_features":{"minItems":2,"maxItems":2,"items":{"enum":["disk-inode-usage-v1","disk-host-jobs-v1"]},"allOf":[{"contains":{"const":"disk-inode-usage-v1"}},{"contains":{"const":"disk-host-jobs-v1"}}]}}}
  },{
    "if": { "required": ["rule_data_channel"] },
    "then": {
      "properties": {
        "id": { "const": "network-threat-detection" },
        "delivery": { "properties": { "provider": { "const": "panel-module" }, "target": { "const": "network-threat-detection" } } }
      }
    }
  },{
    "if": { "required": ["id", "version"], "properties": { "id": { "const": "website-statistics-v2" }, "version": { "const": "2.6.0" } } },
    "then": {
      "required": ["geo_data_channel", "required_panel_features"],
      "properties": { "required_panel_features": { "allOf": [
        { "contains": { "const": "statistics-cursor-retirement-v1" } },
        { "contains": { "const": "statistics-request-identity-v1" } },
        { "contains": { "const": "statistics-geodata-v2" } }
      ] } }
    }
  },{
    "if": { "required": ["geo_data_channel"] },
    "then": {
      "properties": { "id": { "const": "website-statistics-v2" }, "version": { "const": "2.6.0" }, "delivery": { "properties": { "provider": { "const": "panel-module" }, "target": { "const": "website-statistics-v2" } } }, "required_panel_features": { "contains": { "const": "statistics-geodata-v2" } } },
      "required": ["required_panel_features"]
    }
  },{
    "if":{"required":["id","version"],"properties":{"id":{"const":"anti-intrusion"},"version":{"const":"1.1.0"}}},
    "then":{"required":["required_panel_features"],"properties":{"required_panel_features":{"minItems":1,"maxItems":1,"items":{"const":"intrusion-preserving-journal-v2"}}}}
  }]
}
