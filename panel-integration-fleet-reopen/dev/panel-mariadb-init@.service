[Unit]
Description=Initialize Panel MariaDB instance %i

[Service]
Type=oneshot
User=panel-mariadb
Group=panel-mariadb
ExecStart=/opt/panel/bin/panel-executor --init-mariadb %i
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/panel/mariadb/%i
ReadOnlyPaths=/etc/panel/mariadb/%i /opt/panel/runtimes/mariadb
RestrictAddressFamilies=AF_UNIX
