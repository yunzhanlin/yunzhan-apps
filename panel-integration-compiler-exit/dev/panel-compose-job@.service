[Unit]
Description=Panel Docker Compose operation %i
After=docker.service
Requires=docker.service
OnFailure=panel-compose-recovery.service

[Service]
Type=oneshot
ExecStart=/opt/panel/bin/panel-executor --compose-job %i
TimeoutStartSec=30min
KillMode=control-group
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/panel-executor /etc/panel/compose
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
