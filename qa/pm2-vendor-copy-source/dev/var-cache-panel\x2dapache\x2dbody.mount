[Unit]
Description=Fixed bounded temporary Apache request-body cache
# This optional cache is only needed by Apache, after local filesystem setup.
# Keep the readonly sandboxed guard after tmpfiles without a local-fs cycle.
DefaultDependencies=no
After=local-fs.target
Conflicts=umount.target
Before=umount.target
Requires=panel-apache-body-cache-check.service
After=panel-apache-body-cache-check.service
Before=panel-apache.service

[Mount]
What=tmpfs
Where=/var/cache/panel-apache-body
Type=tmpfs
Options=rw,nodev,nosuid,noexec,size=128M,nr_inodes=4096,mode=0755,uid=0,gid=0
DirectoryMode=0755
ReadWriteOnly=yes
TimeoutSec=10
