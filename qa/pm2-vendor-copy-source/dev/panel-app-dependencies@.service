[Unit]
Description=CloudStack fixed application dependency installer %i
After=network-online.target
[Service]
Slice=system.slice
Type=oneshot
User=root
ExecStart=/opt/panel/bin/panel-executor --install-app-dependencies %i
TimeoutStartSec=10min
UMask=0027
NoNewPrivileges=true
ProtectHome=true
ProtectControlGroups=true
KillMode=control-group
MemoryHigh=576M
MemoryMax=640M
MemorySwapMax=0
TasksMax=128
CPUQuota=100%
