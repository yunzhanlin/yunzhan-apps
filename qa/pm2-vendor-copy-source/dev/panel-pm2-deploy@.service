[Unit]
Description=CloudStack locked PM2 dependency deployment %i
After=network.target
[Service]
Type=oneshot
ExecStart=/opt/panel/bin/panel-executor --pm2-deploy %i
TimeoutStartSec=660
TimeoutStopSec=15
KillMode=control-group
UMask=0077
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/srv/panel/sites /etc/panel/security-apps
MemoryMax=768M
TasksMax=128
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
