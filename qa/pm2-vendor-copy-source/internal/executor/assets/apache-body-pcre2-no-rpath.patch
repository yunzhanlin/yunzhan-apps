--- a/apache2/Makefile.am
+++ b/apache2/Makefile.am
@@ -122,4 +122,7 @@
 if LINUX
-mod_security2_la_LDFLAGS = -no-undefined -module -avoid-version -R @PCRE_LD_PATH@ \
+# Yunzhan modification 2026-10-11: pcre2-config --libs8 may be only
+# -lpcre2-8. Do not turn it into an absolute runtime library search path.
+# Use the distribution linker/default loader paths, never a DSO RPATH.
+mod_security2_la_LDFLAGS = -no-undefined -module -avoid-version \
     @APR_LDFLAGS@ \
     @APU_LDFLAGS@ \
