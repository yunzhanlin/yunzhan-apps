    "files-sync": {
      "id": "files-sync",
      "name": "Files Sync",
      "category": "professional",
      "version": "2.0.1",
      "summary": "\u5f00\u53d1\u5019\u9009\uff1a\u4fdd\u7559\u589e\u91cf\u540c\u6b65\u3001\u8fdc\u7a0b\u5f52\u6863\u548c Root \u72ec\u7acb\u526f\u672c\uff1b\u4e2d\u65ad\u540e\u7f3a\u5931\u4e3b\u610f\u56fe\u7684\u6709\u754c\u539f\u7247\u6bb5\u53ef\u79bb\u7ebf\u6838\u5bf9\u3001\u6761\u4ef6\u786e\u8ba4\u4fdd\u7559\u5e76\u8ffd\u8ba4\u539f\u56de\u6267\u3002\u539f\u5b57\u8282\u4e0e\u547d\u540d\u7a7a\u95f4\u4fdd\u7559\uff0c\u672a\u77e5\u72b6\u6001\u4e0d\u5192\u5145\u5b8c\u6574\u5907\u4efd\uff1b\u6b63\u5e38\u5b9e\u88c5\u4e0e\u771f\u5b9e\u65ad\u7535\u9a8c\u6536\u4ecd\u5728\u8fdb\u884c\u3002",
      "stage": "ready",
      "risk": "privileged",
      "provider": "panel-module",
      "target": "files-sync",
      "manage_route": "app-modules",
      "capabilities": [
        "\u672c\u673a\u4e0e\u8de8\u670d\u52a1\u5668\u5b9e\u65f6\u3001\u5b9a\u65f6\u53ca\u624b\u52a8\u589e\u91cf\u540c\u6b65\uff1b\u51b2\u7a81\u4fdd\u7559\uff0c\u53d8\u5316\u5e8f\u53f7\u548c\u964d\u7ea7\u8865\u67e5",
        "\u56fa\u5b9a IP\u3001\u72ec\u7acb\u6838\u5b9e SSH \u516c\u94a5\u3001\u52a0\u5bc6\u51ed\u636e\u548c\u53d7\u9650\u975e root SFTP\uff1b\u4e0d\u6267\u884c\u8fdc\u7aef\u547d\u4ee4",
        "\u72ec\u7acb\u8fde\u63a5\u4e0e\u8ba1\u5212\u4fee\u8ba2\u3001\u540e\u53f0\u539f\u4efb\u52a1\u3001\u53d6\u6d88\u53ca\u663e\u5f0f\u6062\u590d\uff0c\u7ec8\u6001\u5f52\u6863\u4fdd\u7559\u8bc1\u636e",
        "\u5b9e\u9645\u8fdc\u7aef\u4e8b\u52a1\u548c\u903b\u8f91\u5bb9\u91cf\u6838\u5bf9\uff0c\u5b8c\u6574\u6458\u8981\u4e0e\u7cbe\u786e\u786e\u8ba4\u7684\u53d7\u63a7\u5f52\u6863\uff0c\u4e0d\u81ea\u52a8\u5220\u9664",
        "\u4ece\u5df2\u63d0\u4ea4\u5e76\u5b8c\u6574\u6838\u5bf9\u7684\u5f52\u6863\u5efa\u7acb\u672c\u673a Root0700/0600 \u72ec\u7acb\u526f\u672c\uff0c\u4e0d\u6539\u539f\u4ef6\u6216\u68c0\u67e5\u70b9",
        "\u8fdc\u7aef\u65e7\u5199\u5165\u53e5\u67c4\u4e0d\u80fd\u66f4\u6539\u672c\u673a\u526f\u672c\uff1b\u7b26\u53f7\u94fe\u63a5\u3001\u786c\u94fe\u63a5\u3001\u5f02\u4e3b\u548c\u672a\u77e5\u8bb0\u5f55\u62d2\u7edd\u63a5\u7ba1",
        "\u771f\u5b9e\u4e2d\u65ad\u4fdd\u7559\u539f\u7247\u6bb5\u548c inode\uff0c\u65b0\u5c1d\u8bd5\u72ec\u7acb\u5b8c\u6210\uff1b\u5b8c\u6574\u539f\u5c1d\u8bd5\u53ef\u79bb\u7ebf\u786e\u8ba4",
        "\u6062\u590d\u7ed1\u5b9a\u5f53\u524d\u5feb\u7167\u4e0e\u4fee\u8ba2\uff0c\u672a\u53d1\u5e03\u539f\u7247\u6bb5\u53ef\u79bb\u7ebf\u76d8\u70b9\u3001\u6761\u4ef6\u4fdd\u7559\u5e76\u8ffd\u8ba4\u539f\u56de\u6267\uff1b\u4e0d\u6388\u6743\u4e0b\u8f7d\u3001\u91cd\u4f20\u6216\u6807\u4e3a\u6210\u529f",
        "\u5b8c\u6574\u672c\u673a\u526f\u672c\u53ef\u79bb\u7ebf\u6838\u9a8c\uff1b\u4e0b\u8f7d\u9010\u6bb5\u6821\u9a8c\u5e76\u5728\u6574\u6587\u4ef6\u6458\u8981\u901a\u8fc7\u540e\u4ea4\u4ed8",
        "\u5b8c\u6574\u7ba1\u7406\u5458\u6743\u9650\u91cd\u65b0\u6838\u5bf9\uff0c\u6743\u9650\u6216\u8d26\u6237\u53d8\u5316\u4e0d\u4ea4\u4ed8\u79c1\u6709\u8bb0\u5f55\u548c\u4e0b\u8f7d",
        "\u5168\u8fde\u63a5\u6700\u591a128\u4efd/1GiB\u6587\u4ef6\u5185\u5bb9\uff08\u542b\u4e2d\u65ad\u7247\u6bb5\uff09\uff1b\u539f\u7247\u6bb5\u5143\u6570\u636e\u53e6\u8bbe\u56fa\u5b9a\u4e0a\u9650\uff0c\u6bcf\u4efd\u6700\u591a8\u6b21\u660e\u786e\u5c1d\u8bd5\uff0c\u4e0d\u81ea\u52a8\u6e05\u7406",
        "\u65b0\u5907\u4efd\u5904\u7406\u5668\u7531\u7b7e\u540d\u6e05\u5355\u72ec\u7acb\u58f0\u660e\uff1b\u65e7\u9762\u677f\u4e0d\u80fd\u501f\u65b0\u7248\u672c\u6807\u7b7e\u83b7\u5f97\u80fd\u529b"
      ],
