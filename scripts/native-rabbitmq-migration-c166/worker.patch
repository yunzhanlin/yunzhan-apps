+//go:build linux
+
+package executor
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestRabbitMQMigrationVolumeRequiresPrivateDockerOwnedPath(t *testing.T) {
+	if os.Geteuid() != 0 {
+		t.Skip("requires native root")
+	}
+	const name = "panel_rabbitmq_0123456789abcdef0123456789abcdef"
+	base := t.TempDir()
+	parent := filepath.Join(base, "volumes", name)
+	path := filepath.Join(parent, "_data")
+	if err := os.MkdirAll(path, 0700); err != nil {
+		t.Fatal(err)
+	}
+	volume := rabbitMQMigrationVolume{Name: name, Mountpoint: path}
+	original, err := openRabbitMQMigrationVolume(base, volume)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer original.Close()
+
+	if err := os.Chmod(parent, 0777); err != nil {
+		t.Fatal(err)
+	}
+	if untrusted, err := openRabbitMQMigrationVolume(base, volume); err == nil {
+		untrusted.Close()
+		t.Fatal("accepted a writable parent around the Docker data volume")
+	}
+	if err := os.Chmod(parent, 0700); err != nil {
+		t.Fatal(err)
+	}
+	alternate := filepath.Join(parent, "different")
+	if err := os.Rename(path, alternate); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(alternate, path); err != nil {
+		t.Fatal(err)
+	}
+	if unsafe, err := openRabbitMQMigrationVolume(base, volume); err == nil {
+		unsafe.Close()
+		t.Fatal("followed a replacement link in the volume mount point")
+	}
+	linkRoot := filepath.Join(t.TempDir(), "linked")
+	if err := os.Symlink(base, linkRoot); err != nil {
+		t.Fatal(err)
+	}
+	volume.Mountpoint = filepath.Join(linkRoot, "volumes", name, "_data")
+	if unsafe, err := openRabbitMQMigrationVolume(linkRoot, volume); err == nil {
+		unsafe.Close()
+		t.Fatal("followed a link in the Docker root")
+	}
+}
diff --git a/internal/executor/docker_rabbitmq_migration_worker_linux.go b/internal/executor/docker_rabbitmq_migration_worker_linux.go
new file mode 100644
index 0000000000000000000000000000000000000000..cb3077d1c49fda7a184ef323c8fc20898a18a854
--- /dev/null
+++ b/internal/executor/docker_rabbitmq_migration_worker_linux.go
@@ -0,0 +1,364 @@
+//go:build linux
+
+package executor
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/url"
+	"os"
+	"os/exec"
+	"strconv"
+	"time"
+
+	"local/panel/internal/core"
+)
+
+var errRabbitMQMigrationPending = errors.New("RabbitMQ 迁移原任务还有未核对的状态，请恢复原任务")
+
+// The caller must own the exclusive Docker and runtime leases and authorize
+// the actor against this exact job. The signed release verifies the target,
+// independently of the caller's permission to take the original offline.
+func stageRabbitMQMigration(ctx context.Context, lease *dockerMutationLease, project *composeUpdateDirectory,
+	journal *os.Root, plan rabbitMQMigrationPlan, authority rabbitMQMigrationAuthority) (rabbitMQMigrationEvent, error) {
+	if !plan.valid() || authority.manifestSHA != plan.TargetManifestSHA {
+		return rabbitMQMigrationEvent{}, errRabbitMQIdentity
+	}
+	var state rabbitMQMigrationEvent
+	err := lease.use(ctx, func(bound context.Context) error {
+		var err error
+		state, err = readRabbitMQMigrationJournal(journal, plan)
+		if err != nil || state.Phase != "prepared" {
+			return errRabbitMQMigrationPending
+		}
+		original, err := rabbitMQMigrationOriginalProject(project, plan)
+		if err != nil {
+			return err
+		}
+		// Pull both exact images while the original still serves traffic.
+		for _, image := range []string{rabbitMQBridgeImage, rabbitMQTargetImage} {
+			pull, cancel := context.WithTimeout(bound, 5*time.Minute)
+			err := dockerPullUnlocked(pull, image)
+			cancel()
+			if err != nil {
+				return err
+			}
+		}
+		state, err = stopRabbitMQMigrationSource(bound, project, journal, plan, original, state)
+		return err
+	})
+	if err != nil {
+		return state, err
+	}
+	for _, step := range []struct {
+		phase string
+		run   func(context.Context, *dockerMutationLease, *os.Root, rabbitMQMigrationPlan, rabbitMQMigrationEvent) (rabbitMQMigrationEvent, error)
+	}{
+		{"copy-intent", prepareRabbitMQMigrationVolume},
+		{"bridge-intent", upgradeRabbitMQOffline},
+		{"target-check-intent", upgradeRabbitMQOffline},
+	} {
+		err = lease.use(ctx, func(bound context.Context) error {
+			if _, err := rabbitMQMigrationOriginalProject(project, plan); err != nil {
+				return err
+			}
+			var err error
+			state, err = appendRabbitMQMigrationEvent(journal, plan, state, step.phase, state.VolumeCopy)
+			return err
+		})
+		if err != nil {
+			return state, err
+		}
+		next, err := step.run(ctx, lease, journal, plan, state)
+		if err != nil {
+			return state, err
+		}
+		state = next
+	}
+	return state, nil
+}
+
+func rabbitMQMigrationOriginalProject(dir *composeUpdateDirectory, plan rabbitMQMigrationPlan) (composeMetadata, error) {
+	if dir == nil || !plan.valid() {
+		return composeMetadata{}, errRabbitMQIdentity
+	}
+	meta, _, err := dir.read("metadata.json", 16<<10)
+	if err != nil || core.Hash(string(meta)) != plan.OriginalMetaSHA {
+		return composeMetadata{}, errRabbitMQIdentity
+	}
+	project, err := rabbitMQProject(meta, plan.ProjectID)
+	if err != nil || project.TemplateID != core.RabbitMQLegacyTemplate {
+		return composeMetadata{}, errRabbitMQIdentity
+	}
+	config, _, err := dir.read("compose.yaml", 48<<10)
+	if err != nil || core.Hash(string(config)) != plan.OriginalConfigSHA ||
+		!core.IsOriginalRabbitMQCompose(string(config), project.HostPort) {
+		return composeMetadata{}, errRabbitMQIdentity
+	}
+	return project, nil
+}
+
+func runningRabbitMQMigrationSource(ctx context.Context, project composeMetadata, plan rabbitMQMigrationPlan) (rabbitMQContainer, error) {
+	broker, err := inspectRabbitMQ(ctx, project)
+	if err != nil || broker.ID != plan.OriginalContainer {
+		return rabbitMQContainer{}, errRabbitMQIdentity
+	}
+	volume, err := rabbitMQOriginalVolume(ctx, project, broker)
+	if err != nil || volume != plan.OriginalVolume {
+		return rabbitMQContainer{}, errRabbitMQIdentity
+	}
+	holders, err := rabbitMQMigrationVolumeAttachments(ctx, volume)
+	if err != nil || len(holders) != 1 || holders[0] != broker.ID {
+		return rabbitMQContainer{}, errRabbitMQIdentity
+	}
+	var actual struct {
+		HostConfig struct {
+			Privileged    *bool
+			PortBindings  map[string][]struct{ HostIP, HostPort string }
+			RestartPolicy struct{ Name string }
+		}
+	}
+	raw, err := dockerRequest(ctx, http.MethodGet, "/containers/"+broker.ID+"/json", nil, nil, 256<<10)
+	if err != nil || memcachedDaemonJSON(raw) != nil || json.Unmarshal(raw, &actual) != nil ||
+		actual.HostConfig.Privileged == nil || *actual.HostConfig.Privileged ||
+		actual.HostConfig.RestartPolicy.Name != "unless-stopped" || len(actual.HostConfig.PortBindings) != 2 {
+		return rabbitMQContainer{}, errRabbitMQIdentity
+	}
+	for containerPort, port := range map[string]int{"15672/tcp": project.HostPort, "5672/tcp": project.HostPort + 1} {
+		binding := actual.HostConfig.PortBindings[containerPort]
+		if len(binding) != 1 || binding[0].HostIP != "127.0.0.1" || binding[0].HostPort != strconv.Itoa(port) {
+			return rabbitMQContainer{}, errRabbitMQIdentity
+		}
+	}
+	return broker, nil
+}
+
+func stopRabbitMQMigrationSource(ctx context.Context, dir *composeUpdateDirectory, journal *os.Root,
+	plan rabbitMQMigrationPlan, original composeMetadata, state rabbitMQMigrationEvent) (rabbitMQMigrationEvent, error) {
+	broker, err := runningRabbitMQMigrationSource(ctx, original, plan)
+	if err != nil {
+		return state, err
+	}
+	if err = checkRabbitMQMigrationBroker(ctx, broker.ID); err != nil {
+		return state, err
+	}
+	next, err := appendRabbitMQMigrationEvent(journal, plan, state, "quiesce-intent", state.VolumeCopy)
+	if err != nil {
+		return state, err
+	}
+	state = next
+	if err = rabbitMQSetListeners(ctx, broker.ID, false); err != nil {
+		return state, err
+	}
+	if err = checkRabbitMQMigrationBroker(ctx, broker.ID); err != nil {
+		return state, err
+	}
+	if _, err = rabbitMQMigrationOriginalProject(dir, plan); err != nil {
+		return state, err
+	}
+	after, err := runningRabbitMQMigrationSource(ctx, original, plan)
+	if err != nil || broker.State != after.State {
+		return state, errRabbitMQIdentity
+	}
+	next, err = appendRabbitMQMigrationEvent(journal, plan, state, "stop-original-intent", state.VolumeCopy)
+	if err != nil {
+		return state, err
+	}
+	state = next
+	if _, err = dockerRequestUnlocked(ctx, http.MethodPost, "/containers/"+broker.ID+"/stop?t=60", nil, nil, 4096); err != nil {
+		return state, err
+	}
+	if _, err = stoppedRabbitMQMigrationSource(ctx, plan); err != nil {
+		return state, err
+	}
+	next, err = appendRabbitMQMigrationEvent(journal, plan, state, "original-stopped", state.VolumeCopy)
+	if err != nil {
+		return state, err
+	}
+	return next, nil
+}
+
+func checkRabbitMQMigrationBroker(ctx context.Context, id string) error {
+	raw, err := rabbitMQRead(ctx, id, "cluster_status")
+	if err != nil {
+		return err
+	}
+	if _, alarms, err := rabbitMQMigrationCluster(raw); err != nil || alarms != 0 {
+		return errors.New("RabbitMQ 原节点存在告警或集群身份不符")
+	}
+	raw, err = rabbitMQRead(ctx, id, "list_feature_flags", "name", "state", "stability")
+	if err != nil {
+		return err
+	}
+	if disabled, err := rabbitMQMigrationFeatures(raw); err != nil || len(disabled) != 0 {
+		return errors.New("RabbitMQ 原节点有未启用的稳定功能标志")
+	}
+	raw, err = rabbitMQRead(ctx, id, "list_connections", "name")
+	if err != nil {
+		return err
+	}
+	var connections []struct{ Name string }
+	if memcachedDaemonJSON(raw) != nil || json.Unmarshal(raw, &connections) != nil || connections == nil {
+		return errors.New("无法核对 RabbitMQ 原节点连接")
+	}
+	if len(connections) != 0 {
+		return errors.New("RabbitMQ 仍有客户端连接，请先停止发件和消费任务")
+	}
+	return nil
+}
+
+// Reconcile the original job after a failure or process restart. The caller
+// reloads the exact private journal and takes a fresh exclusive lease.
+func restoreRabbitMQBeforePublication(ctx context.Context, lease *dockerMutationLease,
+	dir *composeUpdateDirectory, journal *os.Root, plan rabbitMQMigrationPlan) (rabbitMQMigrationEvent, error) {
+	var state rabbitMQMigrationEvent
+	err := lease.use(ctx, func(bound context.Context) error {
+		var err error
+		state, err = readRabbitMQMigrationJournal(journal, plan)
+		if err != nil {
+			return errRabbitMQMigrationPending
+		}
+		original, err := rabbitMQMigrationOriginalProject(dir, plan)
+		if err != nil {
+			return err
+		}
+		switch state.Phase {
+		case "prepared":
+			state, err = appendRabbitMQMigrationEvent(journal, plan, state, "cancelled-before-stop", state.VolumeCopy)
+			return err
+		case "cancelled-before-stop", "original-restored":
+			return nil
+		case "quiesce-intent":
+			state, err = appendRabbitMQMigrationEvent(journal, plan, state, "resume-listeners-intent", state.VolumeCopy)
+		case "resume-listeners-intent", "restore-original-intent", "restart-original-intent":
+		case "stop-original-intent", "original-stopped", "copy-intent", "copy-verified",
+			"bridge-intent", "bridge-stopped", "target-check-intent", "target-verified-offline":
+			state, err = appendRabbitMQMigrationEvent(journal, plan, state, "restore-original-intent", state.VolumeCopy)
+		default:
+			return errRabbitMQMigrationPending
+		}
+		if err != nil {
+			return err
+		}
+		if state.Phase == "restore-original-intent" {
+			if err := removeRabbitMQOfflineCandidates(bound, plan); err != nil {
+				return err
+			}
+			// A canceled client-side stop can continue in the daemon. Stop
+			// the exact old container and wait for its actual exit before
+			// starting it again or declaring it available.
+			if running, err := runningRabbitMQMigrationSource(bound, original, plan); err == nil {
+				if _, err := dockerRequestUnlocked(bound, http.MethodPost, "/containers/"+running.ID+"/stop?t=60", nil, nil, 4096); err != nil {
+					return err
+				}
+			}
+			if _, err := rabbitMQVettedMigrationSource(bound, plan, false); err != nil {
+				return err
+			}
+			state, err = appendRabbitMQMigrationEvent(journal, plan, state, "restart-original-intent", state.VolumeCopy)
+			if err != nil {
+				return err
+			}
+		}
+		if state.Phase == "restart-original-intent" {
+			if _, err := rabbitMQMigrationOriginalProject(dir, plan); err != nil {
+				return err
+			}
+			if _, err := runningRabbitMQMigrationSource(bound, original, plan); err != nil {
+				if _, err := rabbitMQVettedMigrationSource(bound, plan, false); err != nil {
+					return err
+				}
+				if _, err := dockerRequestUnlocked(bound, http.MethodPost, "/containers/"+plan.OriginalContainer+"/start", nil, nil, 4096); err != nil {
+					return err
+				}
+			}
+		}
+		if err := waitRabbitMQOfflineBroker(bound, plan.OriginalContainer, "4.1.4"); err != nil {
+			return err
+		}
+		if _, err := runningRabbitMQMigrationSource(bound, original, plan); err != nil {
+			return err
+		}
+		if err := rabbitMQSetListeners(bound, plan.OriginalContainer, true); err != nil {
+			return err
+		}
+		state, err = appendRabbitMQMigrationEvent(journal, plan, state, "original-restored", state.VolumeCopy)
+		return err
+	})
+	return state, err
+}
+
+func removeRabbitMQOfflineCandidates(ctx context.Context, plan rabbitMQMigrationPlan) error {
+	filter, _ := json.Marshal(map[string][]string{"label": {rabbitMQMigrationVolumeJobLabel + "=" + plan.JobID}})
+	var rows []struct {
+		ID    string `json:"Id"`
+		Names []string
+	}
+	path := "/containers/json?all=1&filters=" + url.QueryEscape(string(filter))
+	raw, err := dockerRequest(ctx, http.MethodGet, path, nil, nil, 256<<10)
+	if err != nil || memcachedDaemonJSON(raw) != nil || json.Unmarshal(raw, &rows) != nil || rows == nil || len(rows) > 2 {
+		return errRabbitMQMigrationPending
+	}
+	for _, row := range rows {
+		if !core.ValidDockerContainerID(row.ID) || len(row.Names) != 1 {
+			return errRabbitMQIdentity
+		}
+		name := rabbitMQOfflineContainerPrefix + plan.JobID
+		var image string
+		switch row.Names[0] {
+		case "/" + name + "-bridge":
+			name += "-bridge"
+			image = rabbitMQBridgeImage
+		case "/" + name + "-target":
+			name += "-target"
+			image = rabbitMQTargetImage
+		default:
+			return errRabbitMQIdentity
+		}
+		volume, err := namedRabbitMQMigrationVolume(ctx, plan.CandidateVolume, rabbitMQCandidateVolumeLabels(plan))
+		if err != nil {
+			return err
+		}
+		status, err := rabbitMQOfflineInspect(ctx, row.ID, name, image, volume, plan, false)
+		if err != nil {
+			return err
+		}
+		endpoint := "/containers/" + row.ID
+		if status == "running" {
+			if _, err := dockerRequestUnlocked(ctx, http.MethodPost, endpoint+"/stop?t=60", nil, nil, 4096); err != nil {
+				return err
+			}
+			status, err = rabbitMQOfflineInspect(ctx, row.ID, name, image, volume, plan, false)
+			if err != nil || status != "exited" {
+				return errRabbitMQMigrationPending
+			}
+		}
+		if _, err := dockerRequestUnlocked(ctx, http.MethodDelete, endpoint+"?v=0", nil, nil, 4096); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func rabbitMQSetListeners(ctx context.Context, id string, resume bool) error {
+	if !core.ValidDockerContainerID(id) {
+		return errRabbitMQIdentity
+	}
+	action := "suspend_listeners"
+	if resume {
+		action = "resume_listeners"
+	}
+	bound, cancel := context.WithTimeout(ctx, 20*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(bound, "/usr/bin/docker", "--host", "unix:///run/docker.sock", "exec",
+		"--user", "rabbitmq", "--env", "HOME=/var/lib/rabbitmq", id,
+		"rabbitmqctl", "--quiet", "--timeout", "16", action)
+	cmd.Env = []string{"PATH=/usr/sbin:/usr/bin:/sbin:/bin", "LANG=C.UTF-8"}
+	cmd.WaitDelay = time.Second
+	if err := cmd.Run(); err != nil {
+		return errors.New("RabbitMQ 原节点的客户端监听状态无法核对")
+	}
+	return nil
+}
diff --git a/internal/executor/docker_rabbitmq_offline_migration_linux.go b/internal/executor/docker_rabbitmq_offline_migration_linux.go
new file mode 100644
index 0000000000000000000000000000000000000000..0b5a3181694f92866f73ac745d6e375539370c25
--- /dev/null
+++ b/internal/executor/docker_rabbitmq_offline_migration_linux.go
@@ -0,0 +1,222 @@
+//go:build linux
+
+package executor
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/url"
+	"os"
+	"os/exec"
+	"time"
+
+	"local/panel/internal/core"
+)
+
+const rabbitMQBridgeImage = "rabbitmq:4.2.9-management-alpine@sha256:77ca2ba3621a95208918e6e331199a6c81129690bf7fc570dc61b6e64726840a"
+const rabbitMQTargetImage = "rabbitmq:4.4.0-management-alpine@sha256:4841f6384ef8313c3594cd3f2e9f40c10805f8a61c45f08a9a5d9ddea8199267"
+const rabbitMQOfflineContainerPrefix = "yunzhan-rabbitmq-offline-"
+
+type rabbitMQOfflineContainerConfig struct {
+	Image      string
+	Hostname   string
+	Env        []string
+	Labels     map[string]string
+	HostConfig struct {
+		Memory      int64
+		NetworkMode string
+		ExtraHosts  []string
+		Mounts      []struct {
+			Type, Source, Target string
+			VolumeOptions        struct{ NoCopy bool }
+		}
+	}
+}
+
+func rabbitMQOfflineConfig(plan rabbitMQMigrationPlan, image string) rabbitMQOfflineContainerConfig {
+	config := rabbitMQOfflineContainerConfig{
+		Image: image, Hostname: "cloudstack-rabbitmq", Labels: rabbitMQCandidateVolumeLabels(plan),
+		Env: []string{"RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS=+S 2:2 +SDcpu 1 +SDio 1"},
+	}
+	config.HostConfig.Memory = 512 << 20
+	config.HostConfig.NetworkMode = "none"
+	config.HostConfig.ExtraHosts = []string{"cloudstack-rabbitmq:127.0.0.1"}
+	config.HostConfig.Mounts = append(config.HostConfig.Mounts, struct {
+		Type, Source, Target string
+		VolumeOptions        struct{ NoCopy bool }
+	}{"volume", plan.CandidateVolume, "/var/lib/rabbitmq", struct{ NoCopy bool }{true}})
+	return config
+}
+
+func rabbitMQOfflineInspect(ctx context.Context, id, name, image string, volume rabbitMQMigrationVolume, plan rabbitMQMigrationPlan, cleanExit bool) (string, error) {
+	var got struct {
+		ID, Name string
+		Mounts   []rabbitMQVolumeMount
+		State    struct {
+			Status, StartedAt string
+			Pid, ExitCode     *int
+			OOMKilled         *bool
+		}
+		Config struct {
+			Image, Hostname string
+			Labels          map[string]string
+		}
+		HostConfig struct {
+			NetworkMode   string
+			Privileged    *bool
+			PortBindings  map[string]json.RawMessage
+			RestartPolicy struct {
+				Name string
+			}
+		}
+	}
+	raw, err := dockerRequest(ctx, http.MethodGet, "/containers/"+id+"/json", nil, nil, 256<<10)
+	if err != nil || memcachedDaemonJSON(raw) != nil || json.Unmarshal(raw, &got) != nil ||
+		got.ID != id || got.Name != "/"+name || got.Config.Image != image || got.Config.Hostname != "cloudstack-rabbitmq" ||
+		got.HostConfig.NetworkMode != "none" || got.HostConfig.Privileged == nil || *got.HostConfig.Privileged ||
+		len(got.HostConfig.PortBindings) != 0 || got.HostConfig.RestartPolicy.Name != "no" && got.HostConfig.RestartPolicy.Name != "" ||
+		got.Config.Labels[rabbitMQMigrationVolumeJobLabel] != plan.JobID || got.Config.Labels[rabbitMQMigrationVolumeProjectLabel] != plan.ProjectID ||
+		len(got.Mounts) != 1 {
+		return "", errors.New("RabbitMQ 离线升级容器身份无法核对")
+	}
+	mount := got.Mounts[0]
+	if mount.Type != "volume" || mount.Name != volume.Name || mount.Driver != "local" ||
+		mount.Source != volume.Mountpoint || mount.Destination != "/var/lib/rabbitmq" || !mount.RW {
+		return "", errors.New("RabbitMQ 离线升级容器没有使用原任务的独立数据卷")
+	}
+	switch got.State.Status {
+	case "created", "running":
+		return got.State.Status, nil
+	case "exited":
+		if got.State.Pid != nil && *got.State.Pid == 0 && got.State.ExitCode != nil && got.State.OOMKilled != nil &&
+			(!cleanExit || *got.State.ExitCode == 0 && !*got.State.OOMKilled) {
+			return "exited", nil
+		}
+	}
+	return "", errors.New("RabbitMQ 离线升级容器异常退出")
+}
+
+func waitRabbitMQOfflineBroker(ctx context.Context, id, version string) error {
+	bound, cancel := context.WithTimeout(ctx, 150*time.Second)
+	defer cancel()
+	ticker := time.NewTicker(3 * time.Second)
+	defer ticker.Stop()
+	for {
+		raw, err := rabbitMQRead(bound, id, "cluster_status")
+		if err == nil {
+			if _, alarms, err := rabbitMQClusterVersion(raw, version); err == nil && alarms == 0 {
+				return nil
+			}
+		}
+		select {
+		case <-bound.Done():
+			return errors.New("RabbitMQ 离线升级节点未在期限内返回目标版本和功能标志")
+		case <-ticker.C:
+		}
+	}
+}
+
+func upgradeRabbitMQOffline(ctx context.Context, lease *dockerMutationLease, journal *os.Root,
+	plan rabbitMQMigrationPlan, phase rabbitMQMigrationEvent) (rabbitMQMigrationEvent, error) {
+	var image, version, suffix, finished string
+	switch phase.Phase {
+	case "bridge-intent":
+		image, version, suffix, finished = rabbitMQBridgeImage, "4.2.9", "-bridge", "bridge-stopped"
+	case "target-check-intent":
+		image, version, suffix, finished = rabbitMQTargetImage, "4.4.0", "-target", "target-verified-offline"
+	default:
+		return rabbitMQMigrationEvent{}, errors.New("RabbitMQ 原任务未进入离线镜像升级阶段")
+	}
+	if !plan.valid() || !core.MatchesPanelRabbitMQImage(core.RabbitMQ440Template, rabbitMQTargetImage) {
+		return rabbitMQMigrationEvent{}, errors.New("RabbitMQ 离线升级身份无法核对")
+	}
+	var result rabbitMQMigrationEvent
+	err := lease.use(ctx, func(bound context.Context) error {
+		retained, err := readRabbitMQMigrationJournal(journal, plan)
+		if err != nil || retained != phase {
+			return errors.New("RabbitMQ 离线升级前的原记录已发生变化")
+		}
+		if _, err := stoppedRabbitMQMigrationSource(bound, plan); err != nil {
+			return err
+		}
+		volume, err := namedRabbitMQMigrationVolume(bound, plan.CandidateVolume, rabbitMQCandidateVolumeLabels(plan))
+		if err != nil {
+			return err
+		}
+		attachments, err := rabbitMQMigrationVolumeAttachments(bound, volume.Name)
+		if err != nil || len(attachments) != 0 {
+			return errors.New("RabbitMQ 离线升级发现候选数据卷已有容器引用")
+		}
+		name := rabbitMQOfflineContainerPrefix + plan.JobID + suffix
+		config := rabbitMQOfflineConfig(plan, image)
+		var created struct {
+			ID string `json:"Id"`
+		}
+		if _, err := dockerRequestUnlocked(bound, http.MethodPost, "/containers/create?name="+url.QueryEscape(name), config, &created, 64<<10); err != nil {
+			return err
+		}
+		if !core.ValidDockerContainerID(created.ID) {
+			return errRabbitMQIdentity
+		}
+		observed, err := rabbitMQOfflineInspect(bound, created.ID, name, image, volume, plan, true)
+		if err != nil || observed != "created" {
+			return errRabbitMQIdentity
+		}
+		endpoint := "/containers/" + created.ID
+		if _, err := dockerRequestUnlocked(bound, http.MethodPost, endpoint+"/start", nil, nil, 4096); err != nil {
+			return err
+		}
+		if err := waitRabbitMQOfflineBroker(bound, created.ID, version); err != nil {
+			return err
+		}
+		if err := rabbitMQEnableStableFlags(bound, created.ID); err != nil {
+			return err
+		}
+		if _, err := dockerRequestUnlocked(bound, http.MethodPost, endpoint+"/stop?t=60", nil, nil, 4096); err != nil {
+			return err
+		}
+		observed, err = rabbitMQOfflineInspect(bound, created.ID, name, image, volume, plan, true)
+		if err != nil || observed != "exited" {
+			return errors.New("RabbitMQ 离线升级后容器没有干净退出")
+		}
+		if _, err = dockerRequestUnlocked(bound, http.MethodDelete, endpoint+"?v=0", nil, nil, 4096); err != nil {
+			return err
+		}
+		attachments, err = rabbitMQMigrationVolumeAttachments(bound, volume.Name)
+		if err != nil || len(attachments) != 0 {
+			return errors.New("RabbitMQ 离线升级结束后数据卷仍被引用")
+		}
+		result, err = appendRabbitMQMigrationEvent(journal, plan, phase, finished, phase.VolumeCopy)
+		return err
+	})
+	return result, err
+}
+
+// Only called after the exact offline container and its network policy were
+// verified inside the active lease. This fixed CLI never targets the old node.
+func rabbitMQEnableStableFlags(ctx context.Context, id string) error {
+	if !core.ValidDockerContainerID(id) {
+		return errRabbitMQIdentity
+	}
+	bound, cancel := context.WithTimeout(ctx, 100*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(bound, "/usr/bin/docker", "--host", "unix:///run/docker.sock", "exec",
+		"--user", "rabbitmq", "--env", "HOME=/var/lib/rabbitmq", id,
+		"rabbitmqctl", "--quiet", "--timeout", "90", "enable_feature_flag", "all")
+	cmd.Env = []string{"PATH=/usr/sbin:/usr/bin:/sbin:/bin", "LANG=C.UTF-8"}
+	cmd.WaitDelay = time.Second
+	if err := cmd.Run(); err != nil {
+		return errors.New("RabbitMQ 离线节点的稳定功能标志未能启用")
+	}
+	raw, err := rabbitMQRead(bound, id, "list_feature_flags", "name", "state", "stability")
+	if err != nil {
+		return err
+	}
+	disabled, err := rabbitMQMigrationFeatures(raw)
+	if err != nil || len(disabled) != 0 {
+		return errors.New("RabbitMQ 离线节点仍有未启用的稳定功能标志")
+	}
+	return nil
+}
