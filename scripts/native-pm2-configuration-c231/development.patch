@@ -0,0 +1,166 @@
+//go:build linux
+
+package executor
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"local/panel/internal/core"
+)
+
+func pm2ArchivePhaseFixture(t *testing.T, phase string) (*Service, string, string, pm2JournalSnapshot) {
+	t.Helper()
+	s, _ := pm2ArchiveActiveFixture(t)
+	before, err := s.snapshotPM2ConfigurationJournal()
+	if err != nil {
+		t.Fatal(err)
+	}
+	id, sha := pm2ArchivePreparedRequestFixture(t, s)
+	module, err := s.moduleRecordDirectory("pm2-manager")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer module.Close()
+	generations, err := s.openPM2ArchivePath("generations", "", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer generations.Close()
+	request, err := s.openPM2ArchivePath("requests", id, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer request.Close()
+	if phase != "before-first" {
+		if err := pm2ArchiveRenameNoReplace(module, "configuration-transactions", generations, id); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if phase == "after-second" {
+		if err := pm2ArchiveRenameNoReplace(request, "prepared-new", module, "configuration-transactions"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return s, id, sha, before
+}
+func TestPM2JournalArchiveRestoreRetainsOriginalsAtEachFilesystemPhase(t *testing.T) {
+	for _, phase := range []string{"before-first", "after-first", "after-second"} {
+		t.Run(phase, func(t *testing.T) {
+			s, id, sha, before := pm2ArchivePhaseFixture(t, phase)
+			calls := 0
+			s.Config.Run = func(context.Context, string, ...string) (string, error) { calls++; return "", nil }
+			in := core.AppModuleInput{PM2OperationID: id, ExpectedSHA: sha, Confirm: "RESTORE PM2 CONFIG ARCHIVE " + id}
+			out, err := s.restorePM2ConfigurationArchive(context.Background(), in)
+			if err != nil {
+				t.Fatal(err)
+			}
+			state := "restored_for_review"
+			if phase == "before-first" {
+				state = "not_moved"
+			}
+			if out.(map[string]any)["archive"].(map[string]any)["state"] != state || out.(map[string]any)["already_terminal"] != false {
+				t.Fatal("reverse recovery completion was misreported")
+			}
+			active, err := s.snapshotPM2ConfigurationJournal()
+			if err != nil || !pm2JournalSameMovedDirectory(before.Directory, active.Directory) || !reflect.DeepEqual(before.Files, active.Files) || calls != 0 {
+				t.Fatal("reverse recovery changed original data, metadata or service")
+			}
+			if generation, err := s.pm2ArchiveGenerationInfo(id); err != nil || generation != nil {
+				t.Fatal("original generation was duplicated or left detached")
+			}
+			again, err := s.restorePM2ConfigurationArchive(context.Background(), in)
+			if err != nil || again.(map[string]any)["already_terminal"] != true {
+				t.Fatal("terminal reverse recovery replayed directory operations")
+			}
+			if rows, err := s.pm2ArchiveCatalogue(); err != nil || len(rows) != 1 || rows[0].Restore == nil {
+				t.Fatal("explicit reverse choice was lost")
+			}
+		})
+	}
+}
+func TestPM2JournalArchiveRestoreDirectionCannotBecomeForwardReplay(t *testing.T) {
+	s, id, sha, _ := pm2ArchivePhaseFixture(t, "after-second")
+	request, err := s.openPM2ArchivePath("requests", id, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	choice := pm2ConfigurationArchiveRestore{Format: 1, ID: id, IntentSHA: sha, Mode: "restore_for_review", RequestedAt: core.Now(), StartedAfterMove: true}
+	raw, err := json.Marshal(choice)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := pm2ArchivePublish(request, "restore.json", raw); err != nil {
+		t.Fatal(err)
+	}
+	request.Close()
+	before, err := s.pm2ArchiveActiveDirectoryInfo()
+	if err != nil || before == nil {
+		t.Fatal(err)
+	}
+	if _, err := s.recoverPM2ConfigurationArchive(context.Background(), core.AppModuleInput{PM2OperationID: id, ExpectedSHA: sha, Confirm: "RECOVER PM2 CONFIG ARCHIVE " + id}); err == nil {
+		t.Fatal("explicit restore choice became a forward retry")
+	}
+	after, err := s.pm2ArchiveActiveDirectoryInfo()
+	if err != nil || !reflect.DeepEqual(before, after) {
+		t.Fatal("refused forward replay changed directory")
+	}
+	out, err := s.restorePM2ConfigurationArchive(context.Background(), core.AppModuleInput{PM2OperationID: id, ExpectedSHA: sha, Confirm: "RESTORE PM2 CONFIG ARCHIVE " + id})
+	if err != nil || out.(map[string]any)["archive"].(map[string]any)["state"] != "restored_for_review" {
+		t.Fatal("explicit reverse choice could not resume")
+	}
+}
+func TestPM2JournalArchiveRestorePreservesUnknownOriginalFileContents(t *testing.T) {
+	s, id, sha, _ := pm2ArchivePhaseFixture(t, "after-first")
+	path := filepath.Join(s.moduleDir("pm2-manager"), "configuration-archives", "generations", id, "retain-original-unknown.json")
+	original := []byte("retained original data requiring review")
+	if err := os.WriteFile(path, original, 0600); err != nil {
+		t.Fatal(err)
+	}
+	out, err := s.restorePM2ConfigurationArchive(context.Background(), core.AppModuleInput{PM2OperationID: id, ExpectedSHA: sha, Confirm: "RESTORE PM2 CONFIG ARCHIVE " + id})
+	if err != nil || out.(map[string]any)["archive"].(map[string]any)["state"] != "restored_for_review" {
+		t.Fatal("original directory was not restored for review")
+	}
+	restored := filepath.Join(s.moduleDir("pm2-manager"), "configuration-transactions", "retain-original-unknown.json")
+	got, err := os.ReadFile(restored)
+	if err != nil || !bytes.Equal(got, original) {
+		t.Fatal("unknown original evidence was changed or removed")
+	}
+	if _, err := s.snapshotPM2ConfigurationJournal(); err == nil {
+		t.Fatal("restored unknown original was falsely presented as a valid journal")
+	}
+}
+func TestPM2JournalArchiveRestoreNeverOverwritesForeignActiveDirectory(t *testing.T) {
+	s, id, sha, _ := pm2ArchivePhaseFixture(t, "after-first")
+	path := filepath.Join(s.moduleDir("pm2-manager"), "configuration-transactions")
+	if err := os.Mkdir(path, 0700); err != nil {
+		t.Fatal(err)
+	}
+	sentinel := filepath.Join(path, "original-foreign")
+	if err := os.WriteFile(sentinel, []byte("retain foreign directory"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	before, err := os.Lstat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.restorePM2ConfigurationArchive(context.Background(), core.AppModuleInput{PM2OperationID: id, ExpectedSHA: sha, Confirm: "RESTORE PM2 CONFIG ARCHIVE " + id}); err == nil {
+		t.Fatal("foreign directory was adopted")
+	}
+	after, err := os.Lstat(path)
+	if err != nil || !programQueueSame(before, after) {
+		t.Fatal("foreign directory metadata was changed")
+	}
+	raw, err := os.ReadFile(sentinel)
+	if err != nil || string(raw) != "retain foreign directory" {
+		t.Fatal("foreign original data was changed")
+	}
+	if generation, err := s.pm2ArchiveGenerationInfo(id); err != nil || generation == nil {
+		t.Fatal("original generation was lost")
+	}
+}
diff --git a/internal/executor/app_pm2_journal_archive_store_linux.go b/internal/executor/app_pm2_journal_archive_store_linux.go
new file mode 100644
index 0000000..869abb3
--- /dev/null
+++ b/internal/executor/app_pm2_journal_archive_store_linux.go
@@ -0,0 +1,167 @@
+//go:build linux
+
+package executor
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"os"
+	"regexp"
+	"sort"
+
+	"golang.org/x/sys/unix"
+	"local/panel/internal/core"
+)
+
+var pm2ArchivePartName = regexp.MustCompile(`^(?:intent|outcome|restore)\.[a-f0-9]{32}\.part$`)
+var pm2ArchiveSingleName = regexp.MustCompile(`^[a-z0-9][a-z0-9.-]{0,95}$`)
+
+// Only parents may be created here. A request ID is reserved separately with
+// exclusive Mkdir, and a generation destination must remain absent until the
+// original journal's atomic rename. Existing directories are never repaired.
+func (s *Service) openPM2ArchivePath(kind, id string, createParents bool) (*modulePrivateDirectory, error) {
+	if kind != "" && kind != "requests" && kind != "generations" || id != "" && (kind == "" || !core.ValidID(id)) {
+		return nil, errors.New("PM2 archive namespace is invalid")
+	}
+	d, err := s.moduleRecordDirectory("pm2-manager")
+	if err != nil {
+		return nil, err
+	}
+	parts := []string{"configuration-archives"}
+	if kind != "" {
+		parts = append(parts, kind)
+	}
+	for _, name := range parts {
+		if err = pm2ConfigChild(d, name, createParents); err != nil {
+			d.Close()
+			return nil, err
+		}
+	}
+	if id != "" {
+		if err = pm2ConfigChild(d, id, false); err != nil {
+			d.Close()
+			return nil, err
+		}
+	}
+	return d, nil
+}
+
+func pm2ArchiveNames(d *modulePrivateDirectory, maximum int) ([]string, error) {
+	if maximum < 1 || maximum > pm2ConfigurationArchiveGenerations {
+		return nil, errors.New("PM2 archive inventory bound is invalid")
+	}
+	before, err := d.Stat(".")
+	if err != nil || !d.current() {
+		return nil, errors.New("PM2 archive inventory parent cannot be verified")
+	}
+	f, err := d.Open(".")
+	if err != nil {
+		return nil, err
+	}
+	entries, readErr := f.ReadDir(maximum + 1)
+	if err = f.Close(); err != nil {
+		return nil, errors.Join(readErr, err)
+	}
+	if readErr != nil && !errors.Is(readErr, io.EOF) || len(entries) > maximum {
+		return nil, errors.New("PM2 complete archive inventory exceeds its bound")
+	}
+	names := make([]string, 0, len(entries))
+	for _, entry := range entries {
+		names = append(names, entry.Name())
+	}
+	sort.Strings(names)
+	if err = pm2ConfigSync(d); err != nil {
+		return nil, err
+	}
+	after, err := d.Stat(".")
+	if err != nil || !programQueueSame(before, after) || !d.current() {
+		return nil, errors.New("PM2 archive namespace changed during inventory")
+	}
+	return names, nil
+}
+
+func pm2ArchiveRead(d *modulePrivateDirectory, name string) ([]byte, error) {
+	fragment := pm2ArchivePartName.MatchString(name)
+	if name != "intent.json" && name != "outcome.json" && name != "restore.json" && !fragment {
+		return nil, errors.New("PM2 archive record name is invalid")
+	}
+	original, err := d.Lstat(name)
+	if err != nil {
+		if errors.Is(err, os.ErrNotExist) && !d.current() {
+			return nil, errors.New("PM2 missing archive record belongs to a changed namespace")
+		}
+		return nil, err
+	}
+	minimum := int64(1)
+	if fragment {
+		minimum = 0
+	}
+	if !moduleRecordInfo(original, false, false) || original.Size() < minimum || original.Size() > pm2ConfigurationArchiveIntentLimit {
+		return nil, errors.New("PM2 archive record identity or capacity cannot be verified")
+	}
+	f, err := d.OpenFile(name, os.O_RDONLY|unix.O_NOFOLLOW|unix.O_NONBLOCK|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	return pm2ConfigReadDurableSized(f, original, func() bool {
+		current, err := d.Lstat(name)
+		return err == nil && programQueueSame(original, current) && d.current()
+	}, minimum, pm2ConfigurationArchiveIntentLimit)
+}
+
+// Callers pin the source object before using this primitive. Both parents
+// remain current and are synced after a no-replace rename. A visible result
+// after a sync error is retained for explicit durable observation/recovery.
+func pm2ArchiveRenameNoReplace(from *modulePrivateDirectory, old string, to *modulePrivateDirectory, next string) (err error) {
+	if !pm2ArchiveSingleName.MatchString(old) || !pm2ArchiveSingleName.MatchString(next) || old == "." || old == ".." || next == "." || next == ".." || !from.current() || !to.current() {
+		return errors.New("PM2 archive rename parent or name is invalid")
+	}
+	a, err := from.Open(".")
+	if err != nil {
+		return err
+	}
+	defer func() { err = errors.Join(err, a.Close()) }()
+	b, err := to.Open(".")
+	if err != nil {
+		return err
+	}
+	defer func() { err = errors.Join(err, b.Close()) }()
+	if err = unix.Renameat2(int(a.Fd()), old, int(b.Fd()), next, unix.RENAME_NOREPLACE); err != nil {
+		return err
+	}
+	if !from.current() || !to.current() {
+		return errors.New("PM2 archive rename namespace changed; both original namespaces retained")
+	}
+	return errors.Join(pm2ConfigSync(from), pm2ConfigSync(to))
+}
+
+// Partial writes never create a partial final record. Unique ordinary private
+// fragments are retained on every failure, and an existing final record is
+// never replaced. Merely finding a fragment never acknowledges a request.
+func pm2ArchivePublish(d *modulePrivateDirectory, name string, raw []byte) error {
+	if name != "intent.json" && name != "outcome.json" && name != "restore.json" || len(raw) < 1 || len(raw) > pm2ConfigurationArchiveIntentLimit || !d.current() {
+		return errors.New("PM2 archive publication identity or capacity is invalid")
+	}
+	prefix := name[:len(name)-len(".json")]
+	part := prefix + "." + core.ID() + ".part"
+	f, err := d.OpenFile(part, os.O_WRONLY|os.O_CREATE|os.O_EXCL|unix.O_NOFOLLOW|unix.O_NONBLOCK|unix.O_CLOEXEC, 0600)
+	if err != nil {
+		return err
+	}
+	if err = pm2ConfigWriteDurable(f, raw); err != nil {
+		return errors.Join(err, pm2ConfigSync(d))
+	}
+	observed, err := pm2ArchiveRead(d, part)
+	if err != nil || !bytes.Equal(observed, raw) {
+		return errors.Join(err, errors.New("PM2 archive complete fragment could not be independently verified"))
+	}
+	if err = pm2ArchiveRenameNoReplace(d, part, d, name); err != nil {
+		return err
+	}
+	final, err := pm2ArchiveRead(d, name)
+	if err != nil || !bytes.Equal(final, raw) {
+		return errors.Join(err, errors.New("PM2 archive final record could not be durably observed"))
+	}
+	return pm2ConfigSync(d)
+}
