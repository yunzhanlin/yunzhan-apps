+
+func pm2ArchiveStoreFixture(t *testing.T) (*Service, *modulePrivateDirectory, string) {
+	t.Helper()
+	s, _, _ := pm2StateAppFixture(t)
+	parent, err := s.openPM2ArchivePath("requests", "", true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	id := core.ID()
+	if err := parent.Mkdir(id, 0700); err != nil {
+		t.Fatal(err)
