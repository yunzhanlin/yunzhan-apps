diff --git a/internal/core/pm2_configuration_archive.go b/internal/core/pm2_configuration_archive.go
new file mode 100644
index 0000000..7ba0b96
--- /dev/null
+++ b/internal/core/pm2_configuration_archive.go
@@ -0,0 +1,121 @@
+package core
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"local/panel/internal/appcatalog"
+	"net/http"
+	"regexp"
+)
+
+// This exact new revision owns the API. Older signed installations retain
+// their previous operations and cannot acquire archive authority by alias.
+const PM2ConfigurationArchiveAppVersion = appcatalog.PM2ConfigurationArchiveVersion
+
+var pm2ConfigurationArchiveDigest = regexp.MustCompile(`^[a-f0-9]{64}$`)
+
+func PM2ConfigurationArchiveAction(action string) bool {
+	return action == "archive-configurations" || action == "recover-configuration-archive" || action == "restore-configuration-archive"
+}
+func ParsePM2ConfigurationArchiveQuery(raw string) (AppModuleInput, error) {
+	in, err := ParsePM2ConfigurationQuery(raw)
+	if err != nil || in.ResourceID != "" || in.Limit > 32 {
+		return AppModuleInput{}, errors.New("配置归档只读查询仅接受原请求标识、最多32项及有界分页")
+	}
+	return in, nil
+}
+
+// A dedicated wire object prevents zero-valued unrelated project, secret,
+// path or deployment fields from entering a whole-journal maintenance action.
+func DecodePM2ConfigurationArchiveInput(action string, raw []byte) (AppModuleInput, error) {
+	var in AppModuleInput
+	if !PM2ConfigurationArchiveAction(action) || len(raw) == 0 || len(raw) > 4096 {
+		return in, errors.New("配置归档请求不是固定有界对象")
+	}
+	d := json.NewDecoder(bytes.NewReader(raw))
+	token, err := d.Token()
+	if err != nil || token != json.Delim('{') {
+		return in, errors.New("配置归档请求须为独立对象")
+	}
+	seen := map[string]bool{}
+	for d.More() {
+		token, err = d.Token()
+		key, ok := token.(string)
+		if err != nil || !ok || seen[key] || (key != "pm2_operation_id" && key != "expected_sha" && key != "confirm") {
+			return in, errors.New("配置归档字段重复或不被支持")
+		}
+		seen[key] = true
+		var value json.RawMessage
+		if d.Decode(&value) != nil || bytes.Equal(bytes.TrimSpace(value), []byte("null")) {
+			return in, errors.New("配置归档字段须为有效值")
+		}
+	}
+	if token, err = d.Token(); err != nil || token != json.Delim('}') || d.Decode(&struct{}{}) != io.EOF || json.Unmarshal(raw, &in) != nil {
+		return in, errors.New("配置归档对象不完整或格式无效")
+	}
+	confirmation := "ARCHIVE PM2 CONFIGURATIONS " + in.ExpectedSHA
+	if action == "recover-configuration-archive" {
+		confirmation = "RECOVER PM2 CONFIG ARCHIVE " + in.PM2OperationID
+	}
+	if action == "restore-configuration-archive" {
+		confirmation = "RESTORE PM2 CONFIG ARCHIVE " + in.PM2OperationID
+	}
+	if len(seen) != 3 || !ValidID(in.PM2OperationID) || !pm2ConfigurationArchiveDigest.MatchString(in.ExpectedSHA) || in.Confirm != confirmation {
+		return AppModuleInput{}, errors.New("请选择原完整清单或归档请求、摘要并填写精确确认")
+	}
+	return in, nil
+}
+func (a *Server) pm2ConfigurationArchiveRoutes(m *http.ServeMux) {
+	m.HandleFunc("GET /api/app-modules/pm2-manager/configuration-archives/{id}/records", a.authorize(func(w http.ResponseWriter, r *http.Request, u identity) {
+		id := r.PathValue("id")
+		if !ValidID(id) {
+			fail(w, 400, "原配置归档标识无效")
+			return
+		}
+		if _, err := ParsePM2ConfigurationQuery(r.URL.RawQuery); err != nil {
+			fail(w, 400, err.Error())
+			return
+		}
+		access, err := a.Store.UserAccess(u.ID)
+		if err != nil || !fullAdministrator(access) {
+			fail(w, 403, "完整配置归档仅完整管理员可读取")
+			return
+		}
+		var out any
+		if err := a.Executor.Call(r.Context(), "GET", "/v1/app-modules/pm2-manager/configuration-archives/"+id+"/records?"+r.URL.RawQuery, nil, &out); err != nil {
+			fail(w, 409, err.Error())
+			return
+		}
+		access, err = a.Store.UserAccess(u.ID)
+		if err != nil || !fullAdministrator(access) {
+			fail(w, 403, "授权已改变，请由完整管理员重新核对原配置归档")
+			return
+		}
+		send(w, 200, out)
+	}))
+
+	m.HandleFunc("GET /api/app-modules/pm2-manager/configuration-archives", a.authorize(func(w http.ResponseWriter, r *http.Request, u identity) {
+		if _, err := ParsePM2ConfigurationArchiveQuery(r.URL.RawQuery); err != nil {
+			fail(w, 400, err.Error())
+			return
+		}
+		access, err := a.Store.UserAccess(u.ID)
+		if err != nil || !fullAdministrator(access) {
+			fail(w, 403, "完整配置归档仅完整管理员可读取")
+			return
+		}
+		var out any
+		if err := a.Executor.Call(r.Context(), "GET", "/v1/app-modules/pm2-manager/configuration-archives?"+r.URL.RawQuery, nil, &out); err != nil {
+			fail(w, 409, err.Error())
+			return
+		}
+		access, err = a.Store.UserAccess(u.ID)
+		if err != nil || !fullAdministrator(access) {
+			fail(w, 403, "授权已改变，请由完整管理员重新核对原配置归档")
+			return
+		}
+		send(w, 200, out)
+	}))
+}
diff --git a/internal/core/pm2_configuration_archive_test.go b/internal/core/pm2_configuration_archive_test.go
new file mode 100644
index 0000000..1489c27
--- /dev/null
+++ b/internal/core/pm2_configuration_archive_test.go
@@ -0,0 +1,139 @@
+package core
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestPM2JournalArchiveInputIsIndependentCanonicalAndBounded(t *testing.T) {
+	id, sha := strings.Repeat("a", 32), strings.Repeat("b", 64)
+	base := `{"pm2_operation_id":"` + id + `","expected_sha":"` + sha + `","confirm":"ARCHIVE PM2 CONFIGURATIONS ` + sha + `"}`
+	if _, err := DecodePM2ConfigurationArchiveInput("archive-configurations", []byte(base)); err != nil {
+		t.Fatal(err)
+	}
+	for _, body := range []string{`null`, `[]`, base + base, strings.TrimSuffix(base, "}"), strings.TrimSuffix(base, "}") + `,"resource_id":""}`, strings.TrimSuffix(base, "}") + `,"password":""}`, strings.Replace(base, `"expected_sha":"`+sha+`"`, `"expected_sha":null`, 1), strings.Replace(base, `"pm2_operation_id":`, `"pm2_operation_id":"`+id+`","pm2_operation_id":`, 1), strings.Replace(base, `"confirm":`, `"confirm":"bad","conf\u0069rm":`, 1), strings.Replace(base, `ARCHIVE PM2 CONFIGURATIONS `, `RECOVER PM2 CONFIG ARCHIVE `, 1)} {
+		if _, err := DecodePM2ConfigurationArchiveInput("archive-configurations", []byte(body)); err == nil {
+			t.Fatal("ambiguous or unrelated archive input accepted", body)
+		}
+	}
+	for action, phrase := range map[string]string{"recover-configuration-archive": "RECOVER PM2 CONFIG ARCHIVE ", "restore-configuration-archive": "RESTORE PM2 CONFIG ARCHIVE "} {
+		body := `{"pm2_operation_id":"` + id + `","expected_sha":"` + sha + `","confirm":"` + phrase + id + `"}`
+		if _, err := DecodePM2ConfigurationArchiveInput(action, []byte(body)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, raw := range []string{"resource_id=owned-project", "limit=33", "limit=01", "offset=513", "limit=1&limit=2", "confirm=anything"} {
+		if _, err := ParsePM2ConfigurationArchiveQuery(raw); err == nil {
+			t.Fatal("unbounded archive read accepted", raw)
+		}
+	}
+	if _, err := ParsePM2ConfigurationArchiveQuery("pm2_operation_id=" + id + "&limit=32&offset=512"); err != nil {
+		t.Fatal(err)
+	}
+}
+func TestPM2JournalArchiveHTTPRequiresFullAdminCSRFExactVersionAndRevocation(t *testing.T) {
+	s := testStore(t)
+	admin := accessUser(t, s, "pm2-archive-master", "admin", nil)
+	limited := accessUser(t, s, "pm2-archive-limited", "admin", []string{"system-tools"})
+	viewer := accessUser(t, s, "pm2-archive-viewer", "viewer", nil)
+	a, err := NewServer(s, Config{DataDir: t.TempDir(), WebDir: t.TempDir(), Origin: "http://127.0.0.1:19100", Socket: "/missing"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	version := PM2ConfigurationArchiveAppVersion
+	calls, writes := 0, 0
+	revoke := false
+	lastBody := ""
+	a.Executor = &ExecutorClient{Client: &http.Client{Transport: scheduleRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		calls++
+		body := `{"configuration_archives":[],"private_result":"must-not-return-after-revocation"}`
+		if r.URL.Path == "/v1/app-modules/pm2-manager" {
+			raw, _ := json.Marshal(map[string]any{"status": SoftwareAppStatus{ID: "pm2-manager", Installed: true, Version: version}})
+			body = string(raw)
+		} else {
+			if r.Method == "POST" {
+				writes++
+				raw, _ := io.ReadAll(r.Body)
+				lastBody = string(raw)
+			}
+			if revoke {
+				if _, err := s.DB.Exec("INSERT INTO app_user_menus VALUES(?, '[]', 1)", admin.ID); err != nil {
+					t.Fatal(err)
+				}
+			}
+		}
+		return &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(body))}, nil
+	})}}
+	request := func(method, path, body, csrf string, cookie *http.Cookie) *httptest.ResponseRecorder {
+		r := httptest.NewRequest(method, path, strings.NewReader(body))
+		r.Header.Set("Origin", a.Config.Origin)
+		r.Header.Set("Content-Type", "application/json")
+		r.Header.Set("X-CSRF-Token", csrf)
+		if cookie != nil {
+			r.AddCookie(cookie)
+		}
+		w := httptest.NewRecorder()
+		a.ServeHTTP(w, r)
+		return w
+	}
+	login := func(name string) (*http.Cookie, string) {
+		w := request("POST", "/api/login", `{"username":"`+name+`","password":"access-test-password-long"}`, "", nil)
+		var out accountSession
+		if w.Code != 200 || json.Unmarshal(w.Body.Bytes(), &out) != nil {
+			t.Fatal(w.Code, w.Body.String())
+		}
+		return w.Result().Cookies()[0], out.CSRF
+	}
+	id, sha := strings.Repeat("a", 32), strings.Repeat("b", 64)
+	body := `{"pm2_operation_id":"` + id + `","expected_sha":"` + sha + `","confirm":"ARCHIVE PM2 CONFIGURATIONS ` + sha + `"}`
+	post := "/api/app-modules/pm2-manager/archive-configurations"
+	get := "/api/app-modules/pm2-manager/configuration-archives?limit=32"
+	for _, u := range []identity{limited, viewer} {
+		cookie, csrf := login(u.Username)
+		before := calls
+		for _, method := range []string{"GET", "POST"} {
+			path := get
+			raw := ""
+			if method == "POST" {
+				path = post
+				raw = body
+			}
+			if w := request(method, path, raw, csrf, cookie); w.Code != 403 || calls != before {
+				t.Fatal("partial administrator reached private archive", w.Code, calls, before)
+			}
+		}
+	}
+	cookie, csrf := login(admin.Username)
+	before := calls
+	if w := request("POST", post, body, "wrong", cookie); w.Code != 403 || calls != before {
+		t.Fatal("archive bypassed CSRF")
+	}
+	if w := request("POST", post, strings.TrimSuffix(body, "}")+`,"entry":""}`, csrf, cookie); w.Code != 400 || calls != before {
+		t.Fatal("unrelated zero-valued field reached executor", w.Code)
+	}
+	version = "7.0.4-compat11"
+	if w := request("POST", post, body, csrf, cookie); w.Code != 409 || writes != 0 {
+		t.Fatal("old application borrowed archive authority", w.Code)
+	}
+	version = PM2ConfigurationArchiveAppVersion
+	if w := request("POST", post, body, csrf, cookie); w.Code != 200 || writes != 1 || lastBody != body {
+		t.Fatal("exact body was not forwarded", w.Code, lastBody)
+	}
+	if w := request("GET", get, "", csrf, cookie); w.Code != 200 || w.Header().Get("Cache-Control") != "no-store" {
+		t.Fatal("readonly archive response not private", w.Code)
+	}
+	revoke = true
+	if w := request("GET", get, "", csrf, cookie); w.Code != 403 || strings.Contains(w.Body.String(), "must-not-return") {
+		t.Fatal("revoked admin received archive data", w.Code)
+	}
+	if _, err := s.DB.Exec("DELETE FROM app_user_menus WHERE user_id=?", admin.ID); err != nil {
+		t.Fatal(err)
+	}
+	if w := request("POST", post, body, csrf, cookie); w.Code != 403 || strings.Contains(w.Body.String(), "must-not-return") {
+		t.Fatal("revoked admin received mutation output", w.Code)
+	}
+}
