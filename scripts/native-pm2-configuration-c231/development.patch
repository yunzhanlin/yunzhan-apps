@@ -0,0 +1,210 @@
+//go:build linux
+
+package executor
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"local/panel/internal/core"
+)
+
+func pm2ArchiveProtocolFixture(t *testing.T) pm2ConfigurationArchiveIntent {
+	t.Helper()
+	s, _, _, record := pm2ConfigFixtureIntent(t)
+	d, err := s.openPM2ConfigStore(false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	receipt := pm2ConfigReceipt{Format: 1, ID: record.Intent.ID, IntentSHA: record.SHA, State: "rolled_back", ManifestSHA: record.Intent.BeforeSHA, FinishedAt: core.Now()}
+	raw, err := json.Marshal(receipt)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw = append(raw, '\n')
+	if err := pm2ConfigCreate(d.modulePrivateDirectory, record.Intent.ID+".result.json", raw); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.Close(); err != nil {
+		t.Fatal(err)
+	}
+	snapshot, err := s.snapshotPM2ConfigurationJournal()
+	if err != nil {
+		t.Fatal(err)
+	}
+	sha, err := snapshot.sha256()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stage := filepath.Join(s.moduleDir("pm2-manager"), "archive-protocol-prepared")
+	if err := os.Mkdir(stage, 0700); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Lstat(stage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	identity, err := pm2JournalIdentityOf(info)
+	if err != nil {
+		t.Fatal(err)
+	}
+	boot, err := currentPM2ConfigBoot()
+	if err != nil {
+		t.Fatal(err)
+	}
+	owner, err := currentModuleApplyOwner()
+	if err != nil {
+		t.Fatal(err)
+	}
+	v := pm2ConfigurationArchiveIntent{Format: 1, ID: core.ID(), CreatedAt: core.Now(), BootID: boot, Owner: owner, RequestSHA: core.Hash("original archive request"), Inventory: snapshot, InventorySHA: sha, PreparedDirectory: identity}
+	if err := validatePM2ConfigurationArchiveIntent(v); err != nil {
+		t.Fatal(err)
+	}
+	return v
+}
+func pm2ArchiveProtocolClone(t *testing.T, v pm2ConfigurationArchiveIntent) pm2ConfigurationArchiveIntent {
+	t.Helper()
+	raw, err := json.Marshal(v)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var next pm2ConfigurationArchiveIntent
+	if err := json.Unmarshal(raw, &next); err != nil {
+		t.Fatal(err)
+	}
+	return next
+}
+func pm2ArchiveProtocolSHA(t *testing.T, v pm2ConfigurationArchiveIntent) string {
+	t.Helper()
+	raw, err := json.Marshal(v)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return pm2ConfigHash(raw)
+}
+func TestPM2JournalArchiveProtocolRejectsUnfinishedOrReboundInventories(t *testing.T) {
+	original := pm2ArchiveProtocolFixture(t)
+	cases := map[string]func(*pm2ConfigurationArchiveIntent){
+		"pending": func(v *pm2ConfigurationArchiveIntent) { v.Inventory.Pending = []string{core.ID()} },
+		"missing-receipt": func(v *pm2ConfigurationArchiveIntent) {
+			for name := range v.Inventory.Files {
+				if filepath.Ext(name) == ".json" && name[len(name)-12:] == ".result.json" {
+					delete(v.Inventory.Files, name)
+				}
+			}
+		},
+		"wrong-count": func(v *pm2ConfigurationArchiveIntent) { v.Inventory.Records++ },
+		"aliased-originals": func(v *pm2ConfigurationArchiveIntent) {
+			var first *pm2JournalFilePin
+			for name, pin := range v.Inventory.Files {
+				if first == nil {
+					copy := pin
+					first = &copy
+					continue
+				}
+				pin.Identity = first.Identity
+				v.Inventory.Files[name] = pin
+			}
+		},
+		"wrong-owner": func(v *pm2ConfigurationArchiveIntent) {
+			for name, pin := range v.Inventory.Files {
+				pin.Identity.UID++
+				v.Inventory.Files[name] = pin
+				break
+			}
+		},
+		"public-record": func(v *pm2ConfigurationArchiveIntent) {
+			for name, pin := range v.Inventory.Files {
+				pin.Identity.Mode = 0100644
+				v.Inventory.Files[name] = pin
+				break
+			}
+		},
+		"linked-record": func(v *pm2ConfigurationArchiveIntent) {
+			for name, pin := range v.Inventory.Files {
+				pin.Identity.Links = 2
+				v.Inventory.Files[name] = pin
+				break
+			}
+		},
+		"damaged-pin": func(v *pm2ConfigurationArchiveIntent) {
+			for name, pin := range v.Inventory.Files {
+				pin.SHA256 = "damaged"
+				v.Inventory.Files[name] = pin
+				break
+			}
+		},
+		"source-as-prepared": func(v *pm2ConfigurationArchiveIntent) {
+			v.PreparedDirectory = v.Inventory.Directory
+			v.PreparedDirectory.GID++
+		},
+		"cross-device-prepared": func(v *pm2ConfigurationArchiveIntent) { v.PreparedDirectory.Device ^= 1 },
+		"missing-owner-time":    func(v *pm2ConfigurationArchiveIntent) { v.Owner.StartTime = 0 },
+		"unknown-format":        func(v *pm2ConfigurationArchiveIntent) { v.Format++ },
+	}
+	for name, alter := range cases {
+		t.Run(name, func(t *testing.T) {
+			v := pm2ArchiveProtocolClone(t, original)
+			alter(&v)
+			sha, err := v.Inventory.sha256()
+			if err != nil {
+				t.Fatal(err)
+			}
+			v.InventorySHA = sha
+			if err := validatePM2ConfigurationArchiveIntent(v); err == nil {
+				t.Fatal("unverifiable or unfinished archive intent accepted")
+			}
+		})
+	}
+	stale := pm2ArchiveProtocolClone(t, original)
+	stale.Inventory.Directory.ChangedNS++
+	if err := validatePM2ConfigurationArchiveIntent(stale); err == nil {
+		t.Fatal("stale complete inventory digest was accepted")
+	}
+}
+func TestPM2JournalArchiveProtocolRetainsRecordedGroupAndRenameWitnesses(t *testing.T) {
+	intent := pm2ArchiveProtocolFixture(t)
+	// Recorded groups are witnesses. They may differ from this reader's group.
+	recordedGroup := uint32(987)
+	if recordedGroup == uint32(os.Getegid()) {
+		recordedGroup++
+	}
+	intent.Inventory.Directory.GID = recordedGroup
+	intent.PreparedDirectory.GID = recordedGroup + 1
+	sha, err := intent.Inventory.sha256()
+	if err != nil {
+		t.Fatal(err)
+	}
+	intent.InventorySHA = sha
+	original := intent.Inventory.Directory
+	original.ChangedNS++
+	active := intent.PreparedDirectory
+	active.ChangedNS++
+	outcome := pm2ConfigurationArchiveOutcome{Format: 1, ID: intent.ID, IntentSHA: pm2ArchiveProtocolSHA(t, intent), State: "archived", FinishedAt: core.Now(), OriginalDirectory: original, ActiveDirectory: active}
+	if err := validatePM2ConfigurationArchiveOutcome(outcome, intent, outcome.IntentSHA); err != nil {
+		t.Fatal(err)
+	}
+	wrongGroup := outcome
+	wrongGroup.OriginalDirectory.GID = uint32(os.Getegid())
+	if err := validatePM2ConfigurationArchiveOutcome(wrongGroup, intent, outcome.IntentSHA); err == nil {
+		t.Fatal("reader group substituted for recorded original group")
+	}
+	wrongInode := outcome
+	wrongInode.ActiveDirectory.Inode++
+	if err := validatePM2ConfigurationArchiveOutcome(wrongInode, intent, outcome.IntentSHA); err == nil {
+		t.Fatal("unbound new active directory adopted")
+	}
+	if err := validatePM2ConfigurationArchiveOutcome(outcome, intent, core.Hash("different original header")); err == nil {
+		t.Fatal("receipt for a different original intent accepted")
+	}
+	for _, state := range []string{"not_moved", "restored_for_review"} {
+		retained := outcome
+		retained.State = state
+		retained.ActiveDirectory = original
+		if err := validatePM2ConfigurationArchiveOutcome(retained, intent, outcome.IntentSHA); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
diff --git a/internal/executor/app_pm2_journal_archive_store_linux.go b/internal/executor/app_pm2_journal_archive_store_linux.go
new file mode 100644
index 0000000..059bd8d
--- /dev/null
+++ b/internal/executor/app_pm2_journal_archive_store_linux.go
@@ -0,0 +1,167 @@
+//go:build linux
+
+package executor
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"os"
+	"regexp"
+	"sort"
+
+	"golang.org/x/sys/unix"
+	"local/panel/internal/core"
+)
+
+var pm2ArchivePartName = regexp.MustCompile(`^(?:intent|outcome)\.[a-f0-9]{32}\.part$`)
+var pm2ArchiveSingleName = regexp.MustCompile(`^[a-z0-9][a-z0-9.-]{0,95}$`)
+
+// Only parents may be created here. A request ID is reserved separately with
+// exclusive Mkdir, and a generation destination must remain absent until the
+// original journal's atomic rename. Existing directories are never repaired.
+func (s *Service) openPM2ArchivePath(kind, id string, createParents bool) (*modulePrivateDirectory, error) {
+	if kind != "" && kind != "requests" && kind != "generations" || id != "" && (kind == "" || !core.ValidID(id)) {
+		return nil, errors.New("PM2 archive namespace is invalid")
+	}
+	d, err := s.moduleRecordDirectory("pm2-manager")
+	if err != nil {
+		return nil, err
+	}
+	parts := []string{"configuration-archives"}
+	if kind != "" {
+		parts = append(parts, kind)
+	}
+	for _, name := range parts {
+		if err = pm2ConfigChild(d, name, createParents); err != nil {
+			d.Close()
+			return nil, err
+		}
+	}
+	if id != "" {
+		if err = pm2ConfigChild(d, id, false); err != nil {
+			d.Close()
+			return nil, err
+		}
+	}
+	return d, nil
+}
+
+func pm2ArchiveNames(d *modulePrivateDirectory, maximum int) ([]string, error) {
+	if maximum < 1 || maximum > pm2ConfigurationArchiveGenerations {
+		return nil, errors.New("PM2 archive inventory bound is invalid")
+	}
+	before, err := d.Stat(".")
+	if err != nil || !d.current() {
+		return nil, errors.New("PM2 archive inventory parent cannot be verified")
+	}
+	f, err := d.Open(".")
+	if err != nil {
+		return nil, err
+	}
+	entries, readErr := f.ReadDir(maximum + 1)
+	if err = f.Close(); err != nil {
+		return nil, errors.Join(readErr, err)
+	}
+	if readErr != nil && !errors.Is(readErr, io.EOF) || len(entries) > maximum {
+		return nil, errors.New("PM2 complete archive inventory exceeds its bound")
+	}
+	names := make([]string, 0, len(entries))
+	for _, entry := range entries {
+		names = append(names, entry.Name())
+	}
+	sort.Strings(names)
+	if err = pm2ConfigSync(d); err != nil {
+		return nil, err
+	}
+	after, err := d.Stat(".")
+	if err != nil || !programQueueSame(before, after) || !d.current() {
+		return nil, errors.New("PM2 archive namespace changed during inventory")
+	}
+	return names, nil
+}
+
+func pm2ArchiveRead(d *modulePrivateDirectory, name string) ([]byte, error) {
+	fragment := pm2ArchivePartName.MatchString(name)
+	if name != "intent.json" && name != "outcome.json" && !fragment {
+		return nil, errors.New("PM2 archive record name is invalid")
+	}
+	original, err := d.Lstat(name)
+	if err != nil {
+		if errors.Is(err, os.ErrNotExist) && !d.current() {
+			return nil, errors.New("PM2 missing archive record belongs to a changed namespace")
+		}
+		return nil, err
+	}
+	minimum := int64(1)
+	if fragment {
+		minimum = 0
+	}
+	if !moduleRecordInfo(original, false, false) || original.Size() < minimum || original.Size() > pm2ConfigurationArchiveIntentLimit {
+		return nil, errors.New("PM2 archive record identity or capacity cannot be verified")
+	}
+	f, err := d.OpenFile(name, os.O_RDONLY|unix.O_NOFOLLOW|unix.O_NONBLOCK|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	return pm2ConfigReadDurableSized(f, original, func() bool {
+		current, err := d.Lstat(name)
+		return err == nil && programQueueSame(original, current) && d.current()
+	}, minimum, pm2ConfigurationArchiveIntentLimit)
+}
+
+// Callers pin the source object before using this primitive. Both parents
+// remain current and are synced after a no-replace rename. A visible result
+// after a sync error is retained for explicit durable observation/recovery.
+func pm2ArchiveRenameNoReplace(from *modulePrivateDirectory, old string, to *modulePrivateDirectory, next string) (err error) {
+	if !pm2ArchiveSingleName.MatchString(old) || !pm2ArchiveSingleName.MatchString(next) || old == "." || old == ".." || next == "." || next == ".." || !from.current() || !to.current() {
+		return errors.New("PM2 archive rename parent or name is invalid")
+	}
+	a, err := from.Open(".")
+	if err != nil {
+		return err
+	}
+	defer func() { err = errors.Join(err, a.Close()) }()
+	b, err := to.Open(".")
+	if err != nil {
+		return err
+	}
+	defer func() { err = errors.Join(err, b.Close()) }()
+	if err = unix.Renameat2(int(a.Fd()), old, int(b.Fd()), next, unix.RENAME_NOREPLACE); err != nil {
+		return err
+	}
+	if !from.current() || !to.current() {
+		return errors.New("PM2 archive rename namespace changed; both original namespaces retained")
+	}
+	return errors.Join(pm2ConfigSync(from), pm2ConfigSync(to))
+}
+
+// Partial writes never create a partial final record. Unique ordinary private
+// fragments are retained on every failure, and an existing final record is
+// never replaced. Merely finding a fragment never acknowledges a request.
+func pm2ArchivePublish(d *modulePrivateDirectory, name string, raw []byte) error {
+	if name != "intent.json" && name != "outcome.json" || len(raw) < 1 || len(raw) > pm2ConfigurationArchiveIntentLimit || !d.current() {
+		return errors.New("PM2 archive publication identity or capacity is invalid")
+	}
+	prefix := name[:len(name)-len(".json")]
+	part := prefix + "." + core.ID() + ".part"
+	f, err := d.OpenFile(part, os.O_WRONLY|os.O_CREATE|os.O_EXCL|unix.O_NOFOLLOW|unix.O_NONBLOCK|unix.O_CLOEXEC, 0600)
+	if err != nil {
+		return err
+	}
+	if err = pm2ConfigWriteDurable(f, raw); err != nil {
+		return errors.Join(err, pm2ConfigSync(d))
+	}
+	observed, err := pm2ArchiveRead(d, part)
+	if err != nil || !bytes.Equal(observed, raw) {
+		return errors.Join(err, errors.New("PM2 archive complete fragment could not be independently verified"))
+	}
+	if err = pm2ArchiveRenameNoReplace(d, part, d, name); err != nil {
+		return err
+	}
+	final, err := pm2ArchiveRead(d, name)
+	if err != nil || !bytes.Equal(final, raw) {
+		return errors.Join(err, errors.New("PM2 archive final record could not be durably observed"))
+	}
+	return pm2ConfigSync(d)
+}
