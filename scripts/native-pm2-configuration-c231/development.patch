@@ -0,0 +1,210 @@
+//go:build linux
+
+package executor
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"local/panel/internal/core"
+)
+
+func pm2ArchiveProtocolFixture(t *testing.T) pm2ConfigurationArchiveIntent {
+	t.Helper()
+	s, _, _, record := pm2ConfigFixtureIntent(t)
+	d, err := s.openPM2ConfigStore(false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	receipt := pm2ConfigReceipt{Format: 1, ID: record.Intent.ID, IntentSHA: record.SHA, State: "rolled_back", ManifestSHA: record.Intent.BeforeSHA, FinishedAt: core.Now()}
+	raw, err := json.Marshal(receipt)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw = append(raw, '\n')
+	if err := pm2ConfigCreate(d.modulePrivateDirectory, record.Intent.ID+".result.json", raw); err != nil {
+		t.Fatal(err)
+	}
+	if err := d.Close(); err != nil {
+		t.Fatal(err)
+	}
+	snapshot, err := s.snapshotPM2ConfigurationJournal()
+	if err != nil {
+		t.Fatal(err)
+	}
+	sha, err := snapshot.sha256()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stage := filepath.Join(s.moduleDir("pm2-manager"), "archive-protocol-prepared")
+	if err := os.Mkdir(stage, 0700); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Lstat(stage)
+	if err != nil {
+		t.Fatal(err)
+	}
+	identity, err := pm2JournalIdentityOf(info)
+	if err != nil {
+		t.Fatal(err)
+	}
+	boot, err := currentPM2ConfigBoot()
+	if err != nil {
+		t.Fatal(err)
+	}
+	owner, err := currentModuleApplyOwner()
+	if err != nil {
+		t.Fatal(err)
+	}
+	v := pm2ConfigurationArchiveIntent{Format: 1, ID: core.ID(), CreatedAt: core.Now(), BootID: boot, Owner: owner, RequestSHA: core.Hash("original archive request"), Inventory: snapshot, InventorySHA: sha, PreparedDirectory: identity}
+	if err := validatePM2ConfigurationArchiveIntent(v); err != nil {
+		t.Fatal(err)
+	}
+	return v
+}
+func pm2ArchiveProtocolClone(t *testing.T, v pm2ConfigurationArchiveIntent) pm2ConfigurationArchiveIntent {
+	t.Helper()
+	raw, err := json.Marshal(v)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var next pm2ConfigurationArchiveIntent
+	if err := json.Unmarshal(raw, &next); err != nil {
+		t.Fatal(err)
+	}
+	return next
+}
+func pm2ArchiveProtocolSHA(t *testing.T, v pm2ConfigurationArchiveIntent) string {
+	t.Helper()
+	raw, err := json.Marshal(v)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return pm2ConfigHash(raw)
+}
+func TestPM2JournalArchiveProtocolRejectsUnfinishedOrReboundInventories(t *testing.T) {
+	original := pm2ArchiveProtocolFixture(t)
+	cases := map[string]func(*pm2ConfigurationArchiveIntent){
+		"pending": func(v *pm2ConfigurationArchiveIntent) { v.Inventory.Pending = []string{core.ID()} },
+		"missing-receipt": func(v *pm2ConfigurationArchiveIntent) {
+			for name := range v.Inventory.Files {
+				if filepath.Ext(name) == ".json" && name[len(name)-12:] == ".result.json" {
+					delete(v.Inventory.Files, name)
+				}
+			}
+		},
+		"wrong-count": func(v *pm2ConfigurationArchiveIntent) { v.Inventory.Records++ },
+		"aliased-originals": func(v *pm2ConfigurationArchiveIntent) {
+			var first *pm2JournalFilePin
+			for name, pin := range v.Inventory.Files {
+				if first == nil {
+					copy := pin
+					first = &copy
+					continue
+				}
+				pin.Identity = first.Identity
+				v.Inventory.Files[name] = pin
+			}
+		},
+		"wrong-owner": func(v *pm2ConfigurationArchiveIntent) {
+			for name, pin := range v.Inventory.Files {
+				pin.Identity.UID++
+				v.Inventory.Files[name] = pin
+				break
+			}
+		},
+		"public-record": func(v *pm2ConfigurationArchiveIntent) {
+			for name, pin := range v.Inventory.Files {
+				pin.Identity.Mode = 0100644
+				v.Inventory.Files[name] = pin
+				break
+			}
+		},
+		"linked-record": func(v *pm2ConfigurationArchiveIntent) {
+			for name, pin := range v.Inventory.Files {
+				pin.Identity.Links = 2
+				v.Inventory.Files[name] = pin
+				break
+			}
+		},
+		"damaged-pin": func(v *pm2ConfigurationArchiveIntent) {
+			for name, pin := range v.Inventory.Files {
+				pin.SHA256 = "damaged"
+				v.Inventory.Files[name] = pin
+				break
+			}
+		},
+		"source-as-prepared": func(v *pm2ConfigurationArchiveIntent) {
+			v.PreparedDirectory = v.Inventory.Directory
+			v.PreparedDirectory.GID++
+		},
+		"cross-device-prepared": func(v *pm2ConfigurationArchiveIntent) { v.PreparedDirectory.Device ^= 1 },
+		"missing-owner-time":    func(v *pm2ConfigurationArchiveIntent) { v.Owner.StartTime = 0 },
+		"unknown-format":        func(v *pm2ConfigurationArchiveIntent) { v.Format++ },
+	}
+	for name, alter := range cases {
+		t.Run(name, func(t *testing.T) {
+			v := pm2ArchiveProtocolClone(t, original)
+			alter(&v)
+			sha, err := v.Inventory.sha256()
+			if err != nil {
+				t.Fatal(err)
+			}
+			v.InventorySHA = sha
+			if err := validatePM2ConfigurationArchiveIntent(v); err == nil {
+				t.Fatal("unverifiable or unfinished archive intent accepted")
+			}
+		})
+	}
+	stale := pm2ArchiveProtocolClone(t, original)
+	stale.Inventory.Directory.ChangedNS++
+	if err := validatePM2ConfigurationArchiveIntent(stale); err == nil {
+		t.Fatal("stale complete inventory digest was accepted")
+	}
+}
+func TestPM2JournalArchiveProtocolRetainsRecordedGroupAndRenameWitnesses(t *testing.T) {
+	intent := pm2ArchiveProtocolFixture(t)
+	// Recorded groups are witnesses. They may differ from this reader's group.
+	recordedGroup := uint32(987)
+	if recordedGroup == uint32(os.Getegid()) {
+		recordedGroup++
+	}
+	intent.Inventory.Directory.GID = recordedGroup
+	intent.PreparedDirectory.GID = recordedGroup + 1
+	sha, err := intent.Inventory.sha256()
+	if err != nil {
+		t.Fatal(err)
+	}
+	intent.InventorySHA = sha
+	original := intent.Inventory.Directory
+	original.ChangedNS++
+	active := intent.PreparedDirectory
+	active.ChangedNS++
+	outcome := pm2ConfigurationArchiveOutcome{Format: 1, ID: intent.ID, IntentSHA: pm2ArchiveProtocolSHA(t, intent), State: "archived", FinishedAt: core.Now(), OriginalDirectory: original, ActiveDirectory: active}
+	if err := validatePM2ConfigurationArchiveOutcome(outcome, intent, outcome.IntentSHA); err != nil {
+		t.Fatal(err)
+	}
+	wrongGroup := outcome
+	wrongGroup.OriginalDirectory.GID = uint32(os.Getegid())
+	if err := validatePM2ConfigurationArchiveOutcome(wrongGroup, intent, outcome.IntentSHA); err == nil {
+		t.Fatal("reader group substituted for recorded original group")
+	}
+	wrongInode := outcome
+	wrongInode.ActiveDirectory.Inode++
+	if err := validatePM2ConfigurationArchiveOutcome(wrongInode, intent, outcome.IntentSHA); err == nil {
+		t.Fatal("unbound new active directory adopted")
+	}
+	if err := validatePM2ConfigurationArchiveOutcome(outcome, intent, core.Hash("different original header")); err == nil {
+		t.Fatal("receipt for a different original intent accepted")
+	}
+	for _, state := range []string{"not_moved", "restored_for_review"} {
+		retained := outcome
+		retained.State = state
+		retained.ActiveDirectory = original
+		if err := validatePM2ConfigurationArchiveOutcome(retained, intent, outcome.IntentSHA); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
diff --git a/internal/executor/app_pm2_journal_archive_read_linux.go b/internal/executor/app_pm2_journal_archive_read_linux.go
new file mode 100644
index 0000000..e5082e9
--- /dev/null
+++ b/internal/executor/app_pm2_journal_archive_read_linux.go
@@ -0,0 +1,198 @@
+//go:build linux
+
+package executor
+
+import (
+	"errors"
+	"os"
+
+	"local/panel/internal/core"
+)
+
+// This observation is private. Only a small summary, hashes and record counts
+// will be returned by the versioned UI/API; original encrypted manifests and
+// recorded filesystem identities are not regenerated or exposed as form data.
+type pm2ArchiveRequestObservation struct {
+	Restore       *pm2ConfigurationArchiveRestore
+	RestoreSHA    string
+	StoredBytes   int
+	ID            string
+	Intent        *pm2ConfigurationArchiveIntent
+	IntentSHA     string
+	Outcome       *pm2ConfigurationArchiveOutcome
+	OutcomeSHA    string
+	Fragments     map[string]pm2JournalFilePin
+	Prepared      *pm2JournalIdentity
+	PreparedEmpty bool
+}
+
+func (s *Service) openPM2ArchivePrepared(id string) (*modulePrivateDirectory, error) {
+	d, err := s.openPM2ArchivePath("requests", id, false)
+	if err != nil {
+		return nil, err
+	}
+	if err = pm2ConfigChild(d, "prepared-new", false); err != nil {
+		d.Close()
+		return nil, err
+	}
+	return d, nil
+}
+func (s *Service) readPM2ArchiveRequest(id string) (pm2ArchiveRequestObservation, error) {
+	result := pm2ArchiveRequestObservation{ID: id, Fragments: map[string]pm2JournalFilePin{}}
+	if !core.ValidID(id) {
+		return result, errors.New("PM2 archive request identity is invalid")
+	}
+	d, err := s.openPM2ArchivePath("requests", id, false)
+	if err != nil {
+		return result, err
+	}
+	defer d.Close()
+	names, err := pm2ArchiveNames(d, 64)
+	if err != nil {
+		return result, err
+	}
+	var total int
+	for _, name := range names {
+		switch {
+		case name == "prepared-new":
+			prepared, err := s.openPM2ArchivePrepared(id)
+			if err != nil {
+				return result, err
+			}
+			info, statErr := prepared.Stat(".")
+			if statErr != nil {
+				prepared.Close()
+				return result, statErr
+			}
+			identity, identityErr := pm2JournalIdentityOf(info)
+			children, readErr := pm2ArchiveNames(prepared, 1)
+			closeErr := prepared.Close()
+			if identityErr != nil || readErr != nil || closeErr != nil {
+				return result, errors.Join(identityErr, readErr, closeErr)
+			}
+			result.Prepared = &identity
+			result.PreparedEmpty = len(children) == 0
+		case name == "intent.json":
+			raw, err := pm2ArchiveRead(d, name)
+			if err != nil {
+				return result, err
+			}
+			total += len(raw)
+			var intent pm2ConfigurationArchiveIntent
+			if decodeProgramQueueJSON(raw, &intent) != nil || intent.ID != id || validatePM2ConfigurationArchiveIntent(intent) != nil {
+				return result, errors.New("PM2 archive original intent cannot be verified; original retained")
+			}
+			result.Intent = &intent
+			result.IntentSHA = pm2ConfigHash(raw)
+		case name == "restore.json":
+			raw, err := pm2ArchiveRead(d, name)
+			if err != nil {
+				return result, err
+			}
+			total += len(raw)
+			var restore pm2ConfigurationArchiveRestore
+			if decodeProgramQueueJSON(raw, &restore) != nil || restore.ID != id {
+				return result, errors.New("PM2 archive restore choice is unverifiable; retained")
+			}
+			result.Restore = &restore
+			result.RestoreSHA = pm2ConfigHash(raw)
+		case name == "outcome.json":
+			raw, err := pm2ArchiveRead(d, name)
+			if err != nil {
+				return result, err
+			}
+			total += len(raw)
+			var outcome pm2ConfigurationArchiveOutcome
+			if decodeProgramQueueJSON(raw, &outcome) != nil || outcome.ID != id {
+				return result, errors.New("PM2 archive original outcome cannot be verified; original retained")
+			}
+			result.Outcome = &outcome
+			result.OutcomeSHA = pm2ConfigHash(raw)
+		case pm2ArchivePartName.MatchString(name):
+			before, err := d.Lstat(name)
+			if err != nil {
+				return result, err
+			}
+			raw, err := pm2ArchiveRead(d, name)
+			if err != nil {
+				return result, err
+			}
+			total += len(raw)
+			info, err := d.Lstat(name)
+			if err != nil {
+				return result, err
+			}
+			if !programQueueSame(before, info) || info.Size() != int64(len(raw)) {
+				return result, errors.New("PM2 archive original fragment changed during observation")
+			}
+			identity, err := pm2JournalIdentityOf(info)
+			if err != nil {
+				return result, err
+			}
+			result.Fragments[name] = pm2JournalFilePin{Identity: identity, SHA256: pm2ConfigHash(raw)}
+		default:
+			return result, errors.New("PM2 archive request contains unknown original evidence; retained")
+		}
+		if total > 16<<20 {
+			return result, errors.New("PM2 archive complete request exceeds its byte budget")
+		}
+	}
+	if result.Restore != nil {
+		if result.Intent == nil || validatePM2ConfigurationArchiveRestore(*result.Restore, id, result.IntentSHA) != nil {
+			return result, errors.New("PM2 archive restore choice does not bind its original intent")
+		}
+	}
+	if result.Outcome != nil {
+		if result.Restore != nil && result.Outcome.State == "archived" {
+			return result, errors.New("PM2 archive completion conflicts with its explicit restore choice")
+		}
+		if result.Intent == nil || validatePM2ConfigurationArchiveOutcome(*result.Outcome, *result.Intent, result.IntentSHA) != nil {
+			return result, errors.New("PM2 archive original outcome does not bind its original intent")
+		}
+	}
+	if result.Prepared != nil && result.Intent != nil && !pm2JournalSameMovedDirectory(result.Intent.PreparedDirectory, *result.Prepared) {
+		return result, errors.New("PM2 archive prepared directory identity changed; not adopted")
+	}
+	if err := pm2ConfigSync(d); err != nil {
+		return result, err
+	}
+	// Re-list as a complete observation. A concurrently published final record
+	// must not be silently omitted and presented as an unaccepted request.
+	again, err := pm2ArchiveNames(d, 64)
+	if err != nil {
+		return result, err
+	}
+	if len(again) != len(names) {
+		return result, errors.New("PM2 archive request changed during observation")
+	}
+	for i := range names {
+		if names[i] != again[i] {
+			return result, errors.New("PM2 archive original request namespace changed")
+		}
+	}
+	result.StoredBytes = total
+	return result, nil
+}
+
+func (s *Service) pm2ArchiveGenerationInfo(id string) (*pm2JournalIdentity, error) {
+	if !core.ValidID(id) {
+		return nil, errors.New("PM2 archive generation identity is invalid")
+	}
+	d, err := s.openPM2ArchivePath("generations", id, false)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	defer d.Close()
+	info, err := d.Stat(".")
+	if err != nil || !d.current() {
+		return nil, errors.New("PM2 archive generation directory cannot be verified")
+	}
+	identity, err := pm2JournalIdentityOf(info)
+	if err != nil {
+		return nil, err
+	}
+	return &identity, nil
+}
