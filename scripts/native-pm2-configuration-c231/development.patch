+//go:build linux
+
+package executor
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"testing"
+
+	"local/panel/internal/core"
+)
+
+func TestPM2JournalArchiveReadRetainsUnacceptedEmptyFragment(t *testing.T) {
+	s, d, id := pm2ArchiveStoreFixture(t)
+	name := "intent." + core.ID() + ".part"
+	f, err := d.OpenFile(name, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := pm2ConfigWriteDurable(f, nil); err != nil {
+		t.Fatal(err)
+	}
+	d.Close()
+	observed, err := s.readPM2ArchiveRequest(id)
+	if err != nil || observed.Intent != nil || observed.Outcome != nil || len(observed.Fragments) != 1 {
+		t.Fatalf("unaccepted evidence observation: %#v %v", observed, err)
+	}
+	pin := observed.Fragments[name]
+	if pin.Identity.Size != 0 || pin.SHA256 != pm2ConfigHash(nil) {
+		t.Fatal("empty original fragment was not retained and bound")
+	}
+}
+
+func pm2ArchiveReadCompleteFixture(t *testing.T) (*Service, string, core.AppModuleInput) {
+	t.Helper()
+	s, app, _ := pm2StateAppFixture(t)
+	s.Config.Run = func(_ context.Context, command string, args ...string) (string, error) {
+		if command != "/usr/bin/systemctl" || len(args) != 3 || args[0] != "show" {
+			t.Fatalf("archive fixture attempted a service change: %s %v", command, args)
+		}
+		return pm2TestStateText(pm2TestState("inactive", "disabled")), nil
+	}
+	input := core.AppModuleInput{ResourceID: app.ID, ExpectedRevision: app.Revision, PM2OperationID: core.ID(), MemoryMB: 192}
+	if _, err := s.modulePM2(context.Background(), "update", input); err != nil {
+		t.Fatal(err)
+	}
+	active, err := s.openPM2ConfigStore(false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	inventory, err := active.snapshot()
+	if err != nil {
+		t.Fatal(err)
+	}
+	active.Close()
+	parent, err := s.openPM2ArchivePath("requests", "", true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	id := core.ID()
+	if err := parent.Mkdir(id, 0700); err != nil {
+		t.Fatal(err)
+	}
+	parent.Close()
+	d, err := s.openPM2ArchivePath("requests", id, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer d.Close()
+	if err := d.Mkdir("prepared-new", 0700); err != nil {
+		t.Fatal(err)
+	}
+	prepared, err := s.openPM2ArchivePrepared(id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	info, err := prepared.Stat(".")
+	if err != nil {
+		t.Fatal(err)
+	}
+	preparedIdentity, err := pm2JournalIdentityOf(info)
+	if err != nil {
+		t.Fatal(err)
+	}
+	prepared.Close()
+	inventorySHA, err := inventory.sha256()
+	if err != nil {
+		t.Fatal(err)
+	}
+	boot, err := currentPM2ConfigBoot()
+	if err != nil {
+		t.Fatal(err)
+	}
+	owner, err := currentModuleApplyOwner()
+	if err != nil {
+		t.Fatal(err)
+	}
+	intent := pm2ConfigurationArchiveIntent{Format: 1, ID: id, CreatedAt: core.Now(), BootID: boot, Owner: owner, RequestSHA: core.Hash("owned explicit archive request"), Inventory: inventory, InventorySHA: inventorySHA, PreparedDirectory: preparedIdentity}
+	if err := validatePM2ConfigurationArchiveIntent(intent); err != nil {
+		t.Fatal(err)
+	}
+	intentRaw, err := json.MarshalIndent(intent, "", "  ")
+	if err != nil {
+		t.Fatal(err)
+	}
+	intentRaw = append(intentRaw, '\n')
+	if err := pm2ArchivePublish(d, "intent.json", intentRaw); err != nil {
+		t.Fatal(err)
+	}
+	before, err := s.readPM2ArchiveRequest(id)
+	if err != nil || before.IntentSHA != pm2ConfigHash(intentRaw) || before.Prepared == nil || !before.PreparedEmpty || before.Outcome != nil {
+		t.Fatalf("original preparation not observed: %#v %v", before, err)
+	}
+	module, err := s.moduleRecordDirectory("pm2-manager")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer module.Close()
+	generations, err := s.openPM2ArchivePath("generations", "", true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer generations.Close()
+	if err := pm2ArchiveRenameNoReplace(module, "configuration-transactions", generations, id); err != nil {
+		t.Fatal(err)
+	}
+	if err := pm2ArchiveRenameNoReplace(d, "prepared-new", module, "configuration-transactions"); err != nil {
+		t.Fatal(err)
+	}
+	generation, err := s.pm2ArchiveGenerationInfo(id)
+	if err != nil || generation == nil {
+		t.Fatal("original generation was not retained")
+	}
+	newActive, err := s.snapshotPM2ConfigurationJournal()
+	if err != nil || newActive.Records != 0 || !newActive.Exists {
+		t.Fatal("prepared empty journal was not published")
+	}
+	outcome := pm2ConfigurationArchiveOutcome{Format: 1, ID: id, IntentSHA: pm2ConfigHash(intentRaw), State: "archived", FinishedAt: core.Now(), OriginalDirectory: *generation, ActiveDirectory: newActive.Directory}
+	if err := validatePM2ConfigurationArchiveOutcome(outcome, intent, outcome.IntentSHA); err != nil {
+		t.Fatal(err)
+	}
+	outcomeRaw, err := json.MarshalIndent(outcome, "", "    ")
+	if err != nil {
+		t.Fatal(err)
+	}
+	outcomeRaw = append(outcomeRaw, '\n')
+	if err := pm2ArchivePublish(d, "outcome.json", outcomeRaw); err != nil {
+		t.Fatal(err)
+	}
+	observed, err := s.readPM2ArchiveRequest(id)
+	if err != nil || observed.Outcome == nil || observed.Outcome.State != "archived" || observed.Prepared != nil || observed.IntentSHA != pm2ConfigHash(intentRaw) || observed.OutcomeSHA != pm2ConfigHash(outcomeRaw) {
+		t.Fatalf("original archive outcome not durably observed: %#v %v", observed, err)
+	}
+	return s, id, input
+}
+
+func TestPM2JournalArchiveReadActualPrivateWholeGenerationAndOutcome(t *testing.T) {
+	pm2ArchiveReadCompleteFixture(t)
+}
+
+func TestPM2JournalArchiveReadUnknownFinalEvidenceIsNeverEmpty(t *testing.T) {
+	for _, kind := range []string{"unknown", "malformed-intent", "orphan-outcome"} {
+		t.Run(kind, func(t *testing.T) {
+			s, d, id := pm2ArchiveStoreFixture(t)
+			switch kind {
+			case "unknown":
+				f, err := d.OpenFile("retain-unknown.json", os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if err := pm2ConfigWriteDurable(f, []byte("original evidence")); err != nil {
+					t.Fatal(err)
+				}
+			case "malformed-intent":
+				if err := pm2ArchivePublish(d, "intent.json", []byte("original malformed intent")); err != nil {
+					t.Fatal(err)
+				}
+			case "orphan-outcome":
+				raw, err := json.Marshal(pm2ConfigurationArchiveOutcome{Format: 1, ID: id, IntentSHA: core.Hash("missing original"), State: "archived", FinishedAt: core.Now()})
+				if err != nil {
+					t.Fatal(err)
+				}
+				if err := pm2ArchivePublish(d, "outcome.json", raw); err != nil {
+					t.Fatal(err)
+				}
+			}
+			before, err := pm2ArchiveNames(d, 64)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err := s.readPM2ArchiveRequest(id); err == nil {
+				t.Fatal("unverifiable original evidence was presented as an empty/valid request")
+			}
+			after, err := pm2ArchiveNames(d, 64)
+			if err != nil || len(before) != len(after) {
+				t.Fatal("read removed original evidence")
+			}
+			d.Close()
+		})
+	}
+}
diff --git a/internal/executor/app_pm2_journal_archive_restore_linux.go b/internal/executor/app_pm2_journal_archive_restore_linux.go
new file mode 100644
index 0000000..ee2c4f8
--- /dev/null
+++ b/internal/executor/app_pm2_journal_archive_restore_linux.go
@@ -0,0 +1,188 @@
+//go:build linux
+
+package executor
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+
+	"local/panel/internal/core"
+)
+
+func (s *Service) pm2ArchiveActiveDirectoryInfo() (*pm2JournalIdentity, error) {
+	d, err := s.openPM2ConfigStore(false)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	defer d.Close()
+	info, err := d.Stat(".")
+	if err != nil || !d.current() {
+		return nil, errors.New("PM2 active journal directory cannot be verified")
+	}
+	identity, err := pm2JournalIdentityOf(info)
+	if err != nil {
+		return nil, err
+	}
+	return &identity, nil
+}
+
+// Reverse recovery retains the entire original directory for review. It does
+// not claim damaged original records are valid, start a service or modify an
+// encrypted live manifest. Its direction is durably recorded before a rename.
+func (s *Service) restorePM2ConfigurationArchive(ctx context.Context, in core.AppModuleInput) (out any, err error) {
+	if err = pm2ArchiveActionInput(in, "RESTORE PM2 CONFIG ARCHIVE "+in.PM2OperationID); err != nil {
+		return nil, err
+	}
+	if err = ctx.Err(); err != nil {
+		return nil, err
+	}
+	lease, err := s.lockPM2ConfigurationJournal()
+	if err != nil {
+		return nil, err
+	}
+	defer func() {
+		err = errors.Join(err, lease.Close())
+		if err != nil {
+			out = nil
+		}
+	}()
+	observed, err := s.readPM2ArchiveRequest(in.PM2OperationID)
+	if err != nil {
+		return nil, err
+	}
+	if observed.Intent == nil || observed.IntentSHA != in.ExpectedSHA {
+		return nil, errors.New("所选原归档意图无法核对；全部原数据保留")
+	}
+	if observed.Outcome != nil {
+		return map[string]any{"archive": publicPM2ArchiveRequest(observed), "already_terminal": true, "automatic_replay": false, "services_changed": false}, nil
+	}
+	request, err := s.openPM2ArchivePath("requests", in.PM2OperationID, false)
+	if err != nil {
+		return nil, err
+	}
+	defer func() {
+		err = errors.Join(err, request.Close())
+		if err != nil {
+			out = nil
+		}
+	}()
+	module, err := s.moduleRecordDirectory("pm2-manager")
+	if err != nil {
+		return nil, err
+	}
+	defer func() {
+		err = errors.Join(err, module.Close())
+		if err != nil {
+			out = nil
+		}
+	}()
+	generations, err := s.openPM2ArchivePath("generations", "", false)
+	if err != nil {
+		return nil, err
+	}
+	defer func() {
+		err = errors.Join(err, generations.Close())
+		if err != nil {
+			out = nil
+		}
+	}()
+	if observed.Restore == nil {
+		original, observeErr := s.pm2ArchiveGenerationInfo(in.PM2OperationID)
+		if observeErr != nil {
+			return nil, observeErr
+		}
+		choice := pm2ConfigurationArchiveRestore{Format: 1, ID: in.PM2OperationID, IntentSHA: in.ExpectedSHA, Mode: "restore_for_review", RequestedAt: core.Now(), StartedAfterMove: original != nil}
+		raw, err := json.Marshal(choice)
+		if err != nil {
+			return nil, err
+		}
+		raw = append(raw, '\n')
+		if err = pm2ArchivePublish(request, "restore.json", raw); err != nil {
+			return nil, err
+		}
+	}
+	changed := false
+	for step := 0; step < 4; step++ {
+		if err = ctx.Err(); err != nil {
+			return nil, err
+		}
+		if !lease.current() || !request.current() || !module.current() || !generations.current() {
+			return nil, errors.New("原恢复目录已变化；所有目录保留，未采用其他数据")
+		}
+		row, err := s.readPM2ArchiveRequest(in.PM2OperationID)
+		if err != nil {
+			return nil, err
+		}
+		if row.Intent == nil || row.IntentSHA != in.ExpectedSHA || row.Restore == nil {
+			return nil, errors.New("原显式恢复选择无法核对，未改变方向或覆盖数据")
+		}
+		if row.Outcome != nil {
+			return map[string]any{"archive": publicPM2ArchiveRequest(row), "already_terminal": false, "automatic_replay": false, "services_changed": false}, nil
+		}
+		intent := *row.Intent
+		active, err := s.pm2ArchiveActiveDirectoryInfo()
+		if err != nil {
+			return nil, err
+		}
+		original, err := s.pm2ArchiveGenerationInfo(in.PM2OperationID)
+		if err != nil {
+			return nil, err
+		}
+		state := ""
+		switch {
+		case original == nil && active != nil && pm2JournalSameDirectoryObject(intent.Inventory.Directory, *active) && row.Prepared != nil && row.PreparedEmpty && pm2JournalSameMovedDirectory(intent.PreparedDirectory, *row.Prepared):
+			state = "not_moved"
+		case original != nil && pm2JournalSameDirectoryObject(intent.Inventory.Directory, *original) && active != nil && pm2JournalSameDirectoryObject(intent.PreparedDirectory, *active) && row.Prepared == nil:
+			current, err := s.openPM2ConfigStore(false)
+			if err != nil {
+				return nil, err
+			}
+			names, namesErr := pm2ArchiveNames(current.modulePrivateDirectory, 1)
+			closeErr := current.Close()
+			if namesErr != nil || closeErr != nil || len(names) != 0 {
+				return nil, errors.Join(namesErr, closeErr, errors.New("新的活动目录含数据，全部保留；未隐藏或覆盖"))
+			}
+			if err = pm2ArchiveRenameNoReplace(module, "configuration-transactions", request, "prepared-new"); err != nil {
+				return nil, err
+			}
+			changed = true
+		case original != nil && pm2JournalSameDirectoryObject(intent.Inventory.Directory, *original) && active == nil && row.Prepared != nil && row.PreparedEmpty && pm2JournalSameMovedDirectory(intent.PreparedDirectory, *row.Prepared):
+			if err = pm2ArchiveRenameNoReplace(generations, in.PM2OperationID, module, "configuration-transactions"); err != nil {
+				return nil, err
+			}
+			changed = true
+		default:
+			return nil, errors.New("活动、原始或预备目录身份不一致，全部保留；未覆盖任何现有目录")
+		}
+		if state == "" {
+			continue
+		}
+		// Whether a move occurred is a forensic observation, not a claim that every
+		// old configuration is sound. A reverse choice deliberately does not read
+		// or repair unknown original file contents before preserving the directory.
+		if changed || row.Restore.StartedAfterMove {
+			state = "restored_for_review"
+		}
+		outcome := pm2ConfigurationArchiveOutcome{Format: 1, ID: in.PM2OperationID, IntentSHA: in.ExpectedSHA, State: state, FinishedAt: core.Now(), OriginalDirectory: *active, ActiveDirectory: *active}
+		if err = validatePM2ConfigurationArchiveOutcome(outcome, intent, in.ExpectedSHA); err != nil {
+			return nil, err
+		}
+		raw, err := json.Marshal(outcome)
+		if err != nil {
+			return nil, err
+		}
+		raw = append(raw, '\n')
+		if err = ctx.Err(); err != nil {
+			return nil, err
+		}
+		if err = pm2ArchivePublish(request, "outcome.json", raw); err != nil {
+			return nil, err
+		}
+	}
+	return nil, errors.New("恢复原目录的请求已保留，请只读核对持久结果，未重复处理")
+}
diff --git a/internal/executor/app_pm2_journal_archive_restore_linux_test.go b/internal/executor/app_pm2_journal_archive_restore_linux_test.go
