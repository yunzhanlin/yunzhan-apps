import test from 'node:test';
import assert from 'node:assert/strict';
import {readFile,readdir,lstat} from 'node:fs/promises';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {sha256} from '../tools/lib.mjs';
const root=fileURLToPath(new URL('../',import.meta.url)),read=p=>readFile(path.join(root,p)),json=async p=>JSON.parse(await read(p));
const program='0.1.0-dev.proapps24fleetviewbfva',inputs='094aa924f9f5304c9b543499483a0d0b11f78a3a45115e3f4c0fef182878872c';
const gates="normalBuildGates.add('scripts/test-platform-health-view.mjs');\nnormalBuildGates.add('scripts/test-platform-health-lifecycle.mjs');\nnormalBuildGates.add('scripts/test-platform-health-ui.mjs');\nnormalBuildGates.add('scripts/test-platform-health-ui-fixture.mjs');\nnormalBuildGates.add('scripts/test-platform-health-ui-fixture.html');\nnormalBuildGates.add('scripts/test-software-routing-install-browser.mjs');\n";
async function evidence(){
 const r=await json('registry/platform-health-view-candidate.json'),e={};assert.equal(r.evidence_root,'registry/reviewed-platform-health-view/24bfva');assert.equal(Object.keys(r.evidence_sha256).length,4);assert.deepEqual((await readdir(path.join(root,r.evidence_root))).sort(),Object.keys(r.evidence_sha256).sort());
 for(const[n,pin]of Object.entries(r.evidence_sha256)){assert.match(n,/^[a-z0-9-]+\.json$/);const p=r.evidence_root+'/'+n,s=await lstat(path.join(root,p)),raw=await read(p);assert(s.isFile()&&!s.isSymbolicLink()&&s.size<16384);assert.equal(sha256(raw),pin);assert.doesNotMatch(raw.toString(),/BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY|\/Volumes\/|\/var\/lib\/|"(?:password|csrf|token|credentials|actor_id|owner_id|site_id|key)"/);e[n]=JSON.parse(raw);assert.equal(e[n].program,program);assert.equal(e[n].source_inputs_sha256,inputs);assert.equal(e[n].commercial_all50,false);}
 return {r,e};
}
test('new fleet report candidate is an exact independent seventeen-input change, without source overrides or old source replacement',async()=>{
 const{r}=await evidence(),i=await json(r.source_export+'/source-sha256.json'),f=await json(r.source_export+'/release-source-inputs.json'),o=await json(r.previous_source_export+'/source-sha256.json');
 assert.equal(r.program,program);assert.equal(r.source_inputs_sha256,inputs);assert.equal(r.frozen_files,17046);assert.equal(r.source_export,'panel-integration-platform-health-view');assert.equal(r.previous_source_export,'panel-integration-platform-fleet');assert.equal(r.source_overrides,0);assert.deepEqual(i.test_overrides??{},{});assert.equal(o.release.frozen_inputs_sha256,'6446833936f9bc43e06d5d5ec8266bacf18c36d62d145d7033eb9349e0ed15b8');assert.equal(i.release.frozen_inputs_sha256,inputs);assert.equal(f.frozen_inputs_sha256,inputs);assert.equal(i.release.archive_sha256,r.normal_archives.amd64);assert.equal(f.archive_sha256,r.normal_archives.amd64);assert.equal(Object.keys(i.files).length,1390);assert.equal(Object.keys(f.files).length,1350);
 assert.equal(r.only_added_source.length,9);assert.equal(r.only_changed_source.length,8);assert.deepEqual(Object.keys(i.files).filter(p=>!(p in o.files)).sort(),r.only_added_source);assert.deepEqual(Object.keys(i.files).filter(p=>p in o.files&&i.files[p]!==o.files[p]).sort(),r.only_changed_source);assert.deepEqual(Object.keys(o.files).filter(p=>!(p in i.files)),[]);assert.deepEqual(r.removed_source,[]);
 for(const[p,pin]of Object.entries(i.files)){assert(!path.isAbsolute(p)&&path.posix.normalize(p)===p&&!p.split('/').some(x=>['..','.local','.git','node_modules'].includes(x)));const s=await lstat(path.join(root,r.source_export,p));assert(s.isFile()&&!s.isSymbolicLink()&&s.size<=2*1024*1024);assert.equal(sha256(await read(r.source_export+'/'+p)),pin,p);if(p in f.files)assert.equal(f.files[p],pin,p);}
 for(const p of ['scripts/test-platform-health-view.mjs','scripts/test-platform-health-lifecycle.mjs','scripts/test-platform-health-ui.mjs','scripts/test-platform-health-ui-fixture.mjs','scripts/test-platform-health-ui-fixture.html','scripts/test-software-routing-install-browser.mjs'])assert.equal(f.files[p],i.files[p],p);
 for(const p of ['internal/core/platform_health.go','internal/core/platform_health_fleet.go','internal/core/app_module_accounts.go','internal/core/platform_tokens.go','internal/core/platform_maintenance.go','internal/core/disk_host_jobs.go','internal/executor/app_disk_host_result.go','web/src/FileManager.vue'])assert.equal(i.files[p],o.files[p],p);
});
test('dedicated cards preserve unknown telemetry and original selection; cancellation is confined to explicit health reads',async()=>{
 const{r}=await evidence(),n=r.source_export+'/',report=(await read(n+'web/src/PlatformHealthReport.vue')).toString(),view=(await read(n+'web/src/platformHealthView.ts')).toString(),manager=(await read(n+'web/src/AppModuleManager.vue')).toString();
 for(const text of ['metric.percent===null?\'未知\'','emit(\'select\',host.source)','保持登记顺序','@media(max-width:640px)','<details','clearInterval(timer)'])assert(report.includes(text),text);assert.doesNotMatch(report,/v-html|fetch\(|props.api|localStorage|sessionStorage/);for(const text of ["platformReadKnown('run',value)",'row.telemetry_complete!==complete','age>120000||age< -30000'])assert(view.includes(text));
 const handler=manager.slice(manager.indexOf('async function executePlatformHealthRead('),manager.indexOf('async function execute(action:'));assert(handler.includes("props.api('/app-modules/platform-ops/run','POST',{},undefined,request.controller.signal)"));assert(handler.includes('request.controller.signal.aborted'));assert(handler.includes('platformReadRequest.value!==request'));assert.doesNotMatch(handler,/\/add|\/remove|\/revoke-token|\/issue-token|setInterval|setTimeout/);assert(manager.includes('onBeforeUnmount(cancelPlatformHealthRead)'));
 const old=(await read(n+'scripts/test-software-routing-install-browser.mjs')).toString();assert(old.indexOf("throw Error('旧生命周期验收入口已退役")<old.indexOf('fs.readFileSync('));assert(old.indexOf("throw Error('旧生命周期验收入口已退役")<old.indexOf('const backup=ssh('));
 const memcached=(await read(n+'internal/appcatalog/memcached_features.go')).toString();assert(memcached.includes('memcached:1.6.45-alpine@sha256:9e4de012dc607573052061c0bcb38abc775e1dd59b24e7ac38d1892842094aaf'));assert(memcached.includes('m.Version != "1.1.0"'));assert(memcached.includes('len(m.RequiredPanelFeatures) != 1'));assert(memcached.includes('m.Delivery.Image != MemcachedDigestImage'));assert((await read(n+'internal/core/docker.go')).toString().includes('appcatalog.MemcachedDigestImage'));
});
test('normal signed builds and real synthetic browser checks do not claim deployment or live UI acceptance',async()=>{
 const{r,e}=await evidence(),b=e['normal-builds-and-signatures.json'],u=e['local-web-and-synthetic-ui.json'];assert(b.ok&&b.normal_builds_both);assert.equal(b.frozen_files,17046);assert.equal(b.source_overrides,0);assert.equal(b.original_program_public_key_sha256,'4ccfcc861d56a41e3ba7f7ace7e2432c815f366c58448d783df92c6632f01339');assert.equal(b.original_verifier_sha256,'fe128e82b4e11345b320cd782134768bfe1a4df14947c425d7494873a7a7b7b5');assert.deepEqual(b.manager,r.manager);assert.equal(r.manager.sha256,'216fc5d6663fed2fc1bde299cd092d6a29a548a06847ed97ec9d228fd0e0fef6');
 for(const arch of ['arm64','amd64']){assert.equal(b.archives[arch].archive_sha256,r.normal_archives[arch]);assert(b.archives[arch].original_key_signature_verified);assert(b.archives[arch].eager_javascript_bytes<=1200000);for(const k of ['archive_sha256','manifest_sha256','signature_sha256','normal_build_log_sha256'])assert.match(b.archives[arch][k],/^[a-f0-9]{64}$/);}
 assert.equal(u.unit_passes,313);assert.equal(u.unit_failures,0);assert.equal(u.unit_skips,0);assert(u.synthetic_UI_only&&u.synthetic_UI_cases===3);assert.deepEqual(u.synthetic_UI_widths,[1440,390,320]);assert.equal(b.new_program_installed,false);assert.equal(u.new_program_installed,false);
});
test('genuine previous fleet and accidentally selected old lifecycle failure remain distinct original evidence',async()=>{
 const{r,e}=await evidence(),p=e['prior-signed-installed-fleet.json'],bad=e['retained-legacy-test-failure.json'];assert.equal(p.prior_program,'0.1.0-dev.proapps24fleetbftj');assert.equal(p.arch_cases.amd64.ok,true);assert.equal(p.arch_cases.amd64.original_proof_sha256,'e948af2b1eb8df0be4a038c8ffb6fc42606c4fa774fc172cac16d42047a26214');assert.equal(p.arch_cases.arm64.original_strict_guard_ok,false);assert.equal(p.arch_cases.arm64.independent_original_case_guard_ok,true);assert.equal(p.arch_cases.arm64.original_false_proof_sha256,'3bbc535cfc526c2c483a391e52304686bbeebdac8b80f86a31a619faaf1ccb78');assert(p.own_relays_stopped_and_CA_anchors_removed&&p.original_false_ARM_guard_retained);assert.equal(p.module_events_each,37);assert.equal(p.audits_each,39);
 assert.equal(bad.legacy_test_passed,false);assert.equal(bad.actual_uninstall_state,'succeeded');assert.equal(bad.actual_uninstall_job_id,'841b7843f9728267c86750d2a6c3d8b6');for(const k of ['old_script_restored_original_marker','old_jobs_and_native_histories_preserved','protected_files_and_site_collection_configuration_unchanged','entry_now_retired_before_credential_reads_or_SSH','normal_gate_uses_explicit_unit_allowlist','source_negative_entry_test_included'])assert.equal(bad[k],true);assert.equal(bad.audit_records_added_and_retained,4);assert.equal(bad.login_records_added_and_retained,1);assert.equal(bad.main_changed,false);
 for(const k of ['new_program_installed','new_UI_live_agent_verified','main_delivered','app_packages_updated','commercial_all50'])assert.equal(r[k],false);assert(r.remaining.some(s=>s.includes('all50')));
});
test('source exporter and all previous gates remain byte-identical after removing only exact reviewed additions',async()=>{
 const{r}=await evidence(),workflow=(await read('.github/workflows/verify.yml')).toString(),at=workflow.indexOf('      - name: Fleet report and pinned Memcached candidate complete Root Linux contracts');assert(at>0);assert.equal(sha256(Buffer.from(workflow.slice(0,at))),r.previous_ci_full_prefix_sha256);assert.equal(r.previous_ci_full_prefix_sha256,'32bd51a944ec25cb5c9d3564f6cc365fef1d2de5e7035b849c1274ab9ba71fcc');assert.doesNotMatch(workflow,/continue-on-error/);
 for(const text of ['working-directory: panel-integration-platform-health-view','test -p 1 ./... -count=1','go vet ./...','npm ci --prefix panel-integration-platform-health-view/web --ignore-scripts','scripts/test-platform-health-lifecycle.mjs','scripts/test-platform-health-ui.mjs'])assert(workflow.slice(at).includes(text));
 let exporter=(await read('tools/export-panel-source.mjs')).toString();const scope=",'panel-integration-platform-health-view'";assert.equal(exporter.split(scope).length,2);assert.equal(exporter.split(gates).length,2);exporter=exporter.replace(scope,'').replace(gates,'');assert.equal(sha256(Buffer.from(exporter)),r.previous_exporter_sha256);
 let old=(await read('tests/platform-fleet-candidate.test.mjs')).toString();const current=" let exporter=(await read('tools/export-panel-source.mjs')).toString();\n const nextScope=\",'panel-integration-platform-health-view'\",nextGates=\"normalBuildGates.add('scripts/test-platform-health-view.mjs');\\nnormalBuildGates.add('scripts/test-platform-health-lifecycle.mjs');\\nnormalBuildGates.add('scripts/test-platform-health-ui.mjs');\\nnormalBuildGates.add('scripts/test-platform-health-ui-fixture.mjs');\\nnormalBuildGates.add('scripts/test-platform-health-ui-fixture.html');\\nnormalBuildGates.add('scripts/test-software-routing-install-browser.mjs');\\n\";assert.equal(exporter.split(nextScope).length,2);assert.equal(exporter.split(nextGates).length,2);exporter=exporter.replace(nextScope,'').replace(nextGates,'');\n const added=",previous=" let exporter=(await read('tools/export-panel-source.mjs')).toString();const added=";assert.equal(old.split(current).length,2);old=old.replace(current,previous);assert.equal(sha256(Buffer.from(old)),r.previous_fleet_test_sha256);assert.equal(r.previous_fleet_test_sha256,'56e76036c7b3b91357ea6b3639146ce6dbfb8b9e5e3bc1d01b3f8592985019af');
});
