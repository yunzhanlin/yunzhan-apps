{
  "schema_version": 1,
  "id": "platform-ops",
  "name": "Platform Ops",
  "category": "professional",
  "version": "1.3.0",
  "summary": "可安装验收版：保留真实多主机健康读取，新增安装实例绑定的独立限时授权、固定 Nginx 检查、受控重载提交与原请求回执核对。需要签名面板 platform-maintenance-v1 处理器；完整跨主机、批量运维及商用能力仍在验收，不执行自由脚本或补丁发布。",
  "stage": "ready",
  "risk": "privileged",
  "delivery": {
    "provider": "panel-module",
    "target": "platform-ops",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "多主机 HTTPS 健康聚合",
    "旧只读令牌不升级权限",
    "加密凭据与令牌撤销",
    "独立限时可撤销维护授权",
    "安装实例绑定及重装旧授权失效",
    "两端管理员与计划摘要核对",
    "固定 Nginx 配置检查",
    "主机级受控重载提交",
    "原任务原生回执核对",
    "响应未知不重发及升级拦截",
    "不执行自由脚本或补丁发布",
    "执行历史"
  ],
  "required_panel_features": [
    "platform-maintenance-v1"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/platform-ops"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
