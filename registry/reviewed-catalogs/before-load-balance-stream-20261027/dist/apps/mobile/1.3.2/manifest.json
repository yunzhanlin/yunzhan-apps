{
  "schema_version": 1,
  "id": "mobile",
  "name": "云栈移动端",
  "category": "professional",
  "version": "1.3.2",
  "summary": "原证书签名 Android APK、iOS 源码与未签名 arm64 构建；Android 17 权限、后台隐私遮罩、一次性文件选择与失效回调隔离。复用真实面板页面，iOS 安装仍需开发者签名。",
  "stage": "ready",
  "risk": "maintained",
  "delivery": {
    "provider": "panel-module",
    "target": "mobile-pwa",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "PWA",
    "Android APK",
    "iOS 源码与未签名设备构建",
    "可信 HTTPS 与精确来源验证",
    "后台锁屏与设备认证",
    "本地会话清除",
    "SHA-256 交付校验",
    "响应式界面",
    "现有 TOTP 登录",
    "不缓存 API 或凭据",
    "Android 17 本地网络显式授权",
    "隐私遮罩与一次性文件回调"
  ],
  "required_panel_features": [
    "mobile-native-delivery-v132"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/mobile-pwa"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": false
  }
}
