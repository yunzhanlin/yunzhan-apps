{
  "schema_version": 1,
  "id": "docker-manager",
  "name": "Docker Manager",
  "category": "deployment",
  "version": "1-compat1",
  "summary": "安装固定 Docker Engine/CLI/Compose 并管理受限容器、镜像、网络、卷与 Compose。",
  "stage": "ready",
  "risk": "privileged",
  "delivery": {
    "provider": "runtime",
    "target": "docker-auto",
    "manage_route": "docker"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "容器",
    "镜像",
    "Compose",
    "非特权约束"
  ],
  "health": {
    "probe": "systemd",
    "target": "docker.service"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
