{
  "schema_version": 1,
  "id": "anti-intrusion",
  "name": "Anti-intrusion",
  "category": "professional",
  "version": "1.1.0",
  "summary": "SSH 双栈封禁与实际监听端口核验；保留现有封禁的策略事务、进程生命周期校验及原任务摘要绑定恢复。未知结果保持待核对，不自动重启或重试。",
  "stage": "ready",
  "risk": "privileged",
  "delivery": {
    "provider": "panel-module",
    "target": "intrusion-prevention",
    "manage_route": "security"
  },
  "compatibility": {
    "os": [
      "debian-13",
      "ubuntu-24.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "实际 SSH 端口与 IPv4/IPv6 封禁核验",
    "固定 systemd 日志和原生 nftables",
    "文件、进程起始身份、运行策略及内核联合核对",
    "保留现有封禁的限额及端口配置",
    "原任务与完整摘要绑定的显式恢复",
    "未知结果保留原证据且禁止隐式重试",
    "审计解封与并发互斥",
    "原账户请求目录和后端权限约束"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/software"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  },
  "required_panel_features": [
    "intrusion-preserving-journal-v2"
  ]
}
