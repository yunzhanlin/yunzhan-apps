{
  "schema_version": 1,
  "id": "nfs-manager",
  "name": "NFS Manager",
  "category": "professional",
  "version": "1.3.1",
  "summary": "独立 NFSv4 服务端与挂载工具、网站身份映射、双栈持久挂载和事务恢复；升级保留原服务端文件及已有 RPC。需先升级对应签名面板，双架构实装和系统组合验收进行中。",
  "stage": "ready",
  "risk": "privileged",
  "delivery": {
    "provider": "panel-module",
    "target": "nfs-manager",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "NFSv4",
    "独立服务端与网站导出",
    "只读与确认后的读写共享",
    "客户端 CIDR 与网站身份映射",
    "IPv4/IPv6 自定义端口",
    "安全挂载选项",
    "开机恢复",
    "修订保护与失败回滚",
    "独立挂载工具与原 RPC 服务保留",
    "活跃挂载卸载保护",
    "专用操作流程",
    "完整许可与执行历史"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/nfs-manager"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
