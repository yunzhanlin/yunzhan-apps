{
  "schema_version": 1,
  "id": "files-sync",
  "name": "Files Sync",
  "category": "professional",
  "version": "1.4.1",
  "summary": "本机网站 Linux 实时事件增量同步、定时补查与持久计划；保护目标冲突、拒绝实时同步环，暂停立即停止后续写入，历史可筛选分页。 支持签名 Webhook 脱敏通知、持久队列、失败重试与实际送达记录。 接收端慢响应时仍可及时停用并中止旧连接。",
  "stage": "ready",
  "risk": "privileged",
  "delivery": {
    "provider": "panel-module",
    "target": "files-sync",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "增量同步",
    "SHA-256 与逐文件检查点",
    "目标冲突保护",
    "隔离 PHP 网站部署",
    "定时同步计划",
    "Linux 实时同步与溢出补查",
    "实时同步环拒绝",
    "365 天有界历史分页",
    "计划修订与暂停恢复",
    "签名 Webhook 脱敏推送",
    "持久队列与退避重试",
    "实际送达记录"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/files-sync"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
