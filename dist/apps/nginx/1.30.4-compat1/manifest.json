{
  "schema_version": 1,
  "id": "nginx",
  "name": "Nginx",
  "category": "deployment",
  "version": "1.30.4-compat1",
  "summary": "安装可并存的 Nginx 运行时，支持站点绑定、配置校验和安全回滚。",
  "stage": "ready",
  "risk": "maintained",
  "delivery": {
    "provider": "runtime",
    "target": "nginx-1.30.4",
    "manage_route": "sites"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "源码校验",
    "站点配置",
    "热重载",
    "失败回滚"
  ],
  "health": {
    "probe": "binary",
    "target": "nginx -t"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
