{
  "schema_version": 1,
  "id": "website-statistics-v2",
  "name": "Website statistics-v2",
  "category": "professional",
  "version": "2.5.0",
  "summary": "真实日志后台增量 SQLite 历史、30 天/25 万行有界保留、筛选及精确耗时分布。显式更新启用原生请求标识、私有去重回执与完整 CRC 校验的压缩续读；固定配置备份、实际加载探针、待恢复保护。只退役已消失且过期的已读进度，不删原日志。压缩及展开各限64 MiB、每次一份/三秒；百万回执上限不等于吞吐验收。无地理库；需支持两个必需能力的新版面板。",
  "stage": "ready",
  "risk": "maintained",
  "delivery": {
    "provider": "panel-module",
    "target": "website-statistics-v2",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "小时趋势",
    "独立 IP",
    "爬虫识别",
    "错误数",
    "路径排行",
    "来源统计",
    "时间与状态筛选",
    "路径/IP 筛选",
    "慢请求明细",
    "30 天有界历史、进度/请求同事务与安全退役",
    "原生请求标识、私有去重回执、CRC 压缩续读及实际加载恢复保护",
    "精确 P50/P90/P95/P99、九段耗时分布及空样本/超限告警"
  ],
  "required_panel_features": [
    "statistics-cursor-retirement-v1",
    "statistics-request-identity-v1"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/website-statistics-v2"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": false
  }
}
