{
  "schema_version": 1,
  "id": "site-diagnosis",
  "name": "Site Diagnosis",
  "category": "professional",
  "version": "1.0-compat1",
  "summary": "实际网站 HTTP/目录/代码检测与结构化报告通过",
  "stage": "ready",
  "risk": "maintained",
  "delivery": {
    "provider": "panel-module",
    "target": "site-diagnosis",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "DNS 检查",
    "HTTP 检查",
    "TLS 检查",
    "Nginx 配置检查"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/site-diagnosis"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": false
  }
}
