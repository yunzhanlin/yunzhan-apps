{
  "schema_version": 1,
  "id": "load-balance",
  "name": "Load Balance",
  "category": "professional",
  "version": "1.0",
  "summary": "管理 Nginx 上游节点、健康检查、权重、会话粘滞和失败转移。",
  "stage": "design",
  "risk": "privileged",
  "delivery": {
    "provider": "panel-module",
    "target": "load-balance",
    "manage_route": "sites"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "上游节点",
    "权重",
    "健康检查",
    "失败转移"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/load-balancers"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
