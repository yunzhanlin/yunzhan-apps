{
  "schema_version": 1,
  "id": "network-threat-detection",
  "name": "Network Threat Detection",
  "category": "professional",
  "version": "1.3.0",
  "summary": "监听基线与独立非 root 被动 IDS；双签名 BSD ET Web 子集显式下载、选择，数据保存不启用采集；配置损坏仍可核对停止，中断恢复保留后续停止选择；需支持 1.3 的面板，不解密 HTTPS、不自动封禁。",
  "stage": "ready",
  "risk": "privileged",
  "delivery": {
    "provider": "panel-module",
    "target": "network-threat-detection",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "监听端口基线",
    "新增监听告警",
    "公网暴露分类",
    "独立非 root 被动 IDS",
    "双签名开源规则数据",
    "显式规则选择与原创回退",
    "新鲜采集计数核对",
    "有界私有告警历史",
    "损坏配置可信停止",
    "修订与幂等后台任务",
    "中断恢复不重放",
    "停止选择优先于恢复"
  ],
  "rule_data_channel": {
    "id": "et-open-web-bsd-v1",
    "format": 1,
    "engine": "suricata-8.0"
  },
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/network-threat-detection"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": false
  }
}
