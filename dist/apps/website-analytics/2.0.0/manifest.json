{
  "schema_version": 1,
  "id": "website-analytics",
  "name": "Website Analytics",
  "category": "professional",
  "version": "2.0.0",
  "summary": "独立浏览器采集：PV/UV、会话旅程、页面来源、点击坐标和性能；默认关闭，手动同源接入，需支持 2.0 的面板",
  "stage": "ready",
