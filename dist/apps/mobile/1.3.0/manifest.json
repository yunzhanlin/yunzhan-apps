{
  "schema_version": 1,
  "id": "mobile",
  "name": "云栈移动端",
  "category": "professional",
  "version": "1.3.0",
  "summary": "Android 签名 APK、iOS SwiftUI 源码和未签名 arm64 设备构建；原生 TLS、精确来源验证与后台锁屏，复用真实面板业务页。iOS 安装仍需自己的开发者签名。",
  "stage": "ready",
  "risk": "maintained",
  "delivery": {
    "provider": "panel-module",
    "target": "mobile-pwa",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "PWA",
    "Android APK",
    "iOS 源码与未签名设备构建",
    "可信 HTTPS 与精确来源验证",
    "后台锁屏与设备认证",
    "本地会话清除",
    "SHA-256 交付校验",
    "响应式界面",
    "现有 TOTP 登录",
    "不缓存 API 或凭据",
    "专用操作流程",
    "执行历史"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/mobile-pwa"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": false
  }
}
