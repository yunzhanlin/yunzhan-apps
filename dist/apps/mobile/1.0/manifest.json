{
  "schema_version": 1,
  "id": "mobile",
  "name": "aaPanel Mobile",
  "category": "professional",
  "version": "1.0",
  "summary": "安装可添加到主屏的响应式 PWA，使用现有 HTTPS、会话和 TOTP 安全模型。",
  "stage": "design",
  "risk": "maintained",
  "delivery": {
    "provider": "panel-module",
    "target": "mobile-pwa",
    "manage_route": "overview"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "PWA",
    "响应式界面",
    "TOTP",
    "通知摘要"
  ],
  "health": {
    "probe": "http",
    "target": "/manifest.webmanifest"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": false
  }
}
