{
  "schema_version": 1,
  "id": "pm2-manager",
  "name": "PM2 Manager",
  "category": "deployment",
  "version": "7.0.4-compat3",
  "summary": "非 root PM2 应用、1–8 进程、内存阈值和修订号更新；实际端口就绪后才报告成功，失败恢复旧配置。",
  "stage": "ready",
  "risk": "maintained",
  "delivery": {
    "provider": "panel-module",
    "target": "pm2-manager",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "实际 PM2",
    "非 root 进程",
    "日志",
    "启停重启",
    "开机恢复",
    "多进程集群",
    "内存重启阈值",
    "配置修订检查",
    "实际端口就绪",
    "启动失败回滚",
    "专用操作流程",
    "执行历史"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/pm2-manager"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
