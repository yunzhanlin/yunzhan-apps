{
  "schema_version": 1,
  "id": "pm2-manager",
  "name": "PM2 Manager",
  "category": "deployment",
  "version": "7.0.4-compat4",
  "summary": "非 root PM2 集群、加密且仅写入的环境变量、锁定 npm 后台部署；默认禁用安装脚本，可受控启用网站用户构建，失败恢复旧依赖，中断可取消并恢复。",
  "stage": "ready",
  "risk": "maintained",
  "delivery": {
    "provider": "panel-module",
    "target": "pm2-manager",
    "manage_route": "app-modules"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13",
      "ubuntu-22.04",
      "ubuntu-24.04",
      "ubuntu-26.04"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "非 root PM2 集群与启停",
    "日志与执行历史",
    "开机恢复",
    "内存重启阈值",
    "配置修订检查",
    "加密仅写入环境变量增量管理",
    "锁定 npm 依赖后台部署",
    "网站用户受控安装脚本",
    "依赖失败回滚",
    "中断部署恢复与取消",
    "旧部署可恢复归档",
    "启动就绪与配置失败回滚"
  ],
  "health": {
    "probe": "panel-api",
    "target": "/api/app-modules/pm2-manager"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
