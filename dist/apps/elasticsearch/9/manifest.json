{
  "schema_version": 1,
  "id": "elasticsearch",
  "name": "Elasticsearch",
  "category": "deployment",
  "version": "9",
  "summary": "部署单节点 Elasticsearch，限制内存并仅通过回环端口提供服务。",
  "stage": "integration",
  "risk": "maintained",
  "delivery": {
    "provider": "compose",
    "target": "elasticsearch",
    "image": "docker.elastic.co/elasticsearch/elasticsearch:9.1.4",
    "manage_route": "docker"
  },
  "compatibility": {
    "os": [
      "debian-12",
      "debian-13"
    ],
    "architectures": [
      "amd64",
      "arm64"
    ]
  },
  "capabilities": [
    "单节点",
    "内存限额",
    "持久卷",
    "HTTP 健康检查"
  ],
  "health": {
    "probe": "http",
    "target": "/_cluster/health"
  },
  "uninstall": {
    "preserve_data": true,
    "reference_check": true
  }
}
