[Unit]
Description=Panel pinned Analytics HTML engine build %i (no site activation)
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/opt/panel/bin/panel-executor --build-analytics-html %i
TimeoutStartSec=300min
KillMode=control-group
UMask=0077
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/panel-executor /var/cache/panel-analytics-html-build /opt/panel/app-modules
ReadOnlyPaths=/etc/nginx /etc/panel
NoNewPrivileges=true
RestrictSUIDSGID=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID CAP_FOWNER CAP_KILL
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=576M
MemoryMax=640M
MemorySwapMax=0
TasksMax=96
CPUQuota=70%
