[Unit]
Description=Panel isolated MySQL instance %i
After=network.target
[Service]
Type=simple
ExecStart=/opt/panel/bin/panel-executor --serve-mysql %i
RuntimeDirectory=panel-mysql-%i
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=3
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/panel/mysql/%i /run/panel-mysql-%i
ReadOnlyPaths=/etc/panel/mysql/%i
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
[Install]
WantedBy=multi-user.target
