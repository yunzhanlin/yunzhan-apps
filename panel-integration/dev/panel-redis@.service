[Unit]
Description=Panel isolated Redis instance %i
After=network.target

[Service]
Type=simple
ExecStart=/opt/panel/bin/panel-executor --serve-redis %i
RuntimeDirectory=panel-redis-%i
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/panel/redis/%i /run/panel-redis-%i
ReadOnlyPaths=/etc/panel/redis/%i /opt/panel/runtimes/redis
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=10032

[Install]
WantedBy=multi-user.target
