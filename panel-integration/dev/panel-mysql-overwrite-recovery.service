[Unit]
Description=Recover interrupted panel database replacements
After=network.target
[Service]
Type=oneshot
ExecStart=/opt/panel/bin/panel-executor --recover-database-overwrites
TimeoutStartSec=30min
KillMode=control-group
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/panel/mysql /srv/panel/mysql /var/lib/panel-executor /var/backups/panel/mysql
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
