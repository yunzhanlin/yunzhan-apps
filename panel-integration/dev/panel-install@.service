[Unit]
Description=Panel verified runtime installer %i
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/opt/panel/bin/panel-executor --install-job %i
TimeoutStartSec=120min
KillMode=control-group
UMask=0022
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/panel-executor /var/cache/panel-build /opt/panel/runtimes /opt/panel/php-extensions
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
