[Unit]
Description=Panel isolated PHP-FPM pool %i
After=network.target
[Service]
Type=simple
ExecStart=/opt/panel/bin/panel-executor --serve-php %i
Restart=on-failure
RestartSec=2
RuntimeDirectory=panel-php-%i
RuntimeDirectoryMode=0755
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/panel/sites /run/panel-php-%i
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
[Install]
WantedBy=multi-user.target
