[Unit]
Description=Panel signed geographic data operation %i

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/panel/bin/panel-executor --statistics-geodata-job %i
TimeoutStartSec=330s
TimeoutStopSec=10s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/panel-executor/statistics-geodata /var/lib/panel-executor/statistics-geodata-jobs /var/lib/panel-executor/statistics-geodata-instance.lock
ReadOnlyPaths=/etc/panel
InaccessiblePaths=/etc/nginx /etc/systemd/system /srv/panel/sites
Environment=GOMEMLIMIT=768MiB
MemoryHigh=768M
MemoryMax=1G
MemorySwapMax=0
TasksMax=32
CPUQuota=70%
LimitCORE=0
